package views

import (
	"context"
	"strconv"

	"github.com/1xxn/getafjob/internal/web/views/ui"
)

// SaveState is the answer to an autosave: the status line of one form and, for the profile, its new version.
type SaveState struct {
	ID      string // profile, or the station's ID
	State   string // saved, invalid, conflict, error; empty before the first save
	Text    string
	Version int64 // > 0: the form's version input is replaced too
}

// autosave makes a form save itself while the user types (800 ms after the last key) and when a field is left;
// a newer save replaces one still running.
func autosave(ctx context.Context, url, id string) templ.Attributes {
	return HX(ctx, "hx-post", url, "hx-trigger", "input delay:800ms, change", "hx-target", "#save-"+id,
		"hx-swap", "outerHTML transition:false", "hx-sync", "this:replace")
}

// Form carries the values and errors of a form; Errors hold translated texts by field name.
type Form struct {
	Values  map[string]string
	Checks  map[string]bool
	Errors  map[string]string
	Version string
	Notice  string
	Failed  bool // Notice is an error
}

// input builds the props of a one-line field labelled with profile.field.<name>.
func input(ctx context.Context, f Form, name, typ, autocomplete string, maxLen int) ui.InputProps {
	return ui.InputProps{FieldProps: ui.FieldProps{Name: name, Label: T(ctx, "profile.field."+name), Error: f.Errors[name]},
		Type: typ, Value: f.Values[name], Autocomplete: autocomplete, MaxLength: maxLen}
}

// secret is a password field that never shows a stored value; hinted adds profile.hint.<name>.
func secret(ctx context.Context, f Form, name, autocomplete string, hinted bool) ui.InputProps {
	p := input(ctx, f, name, "password", autocomplete, 254)
	p.Value = ""
	if hinted {
		p.Hint = T(ctx, "profile.hint."+name)
	}
	return p
}

// area builds the props of a multi-line field with a hint (profile.hint.<name>).
func area(ctx context.Context, f Form, name string, maxLen int) ui.TextareaProps {
	return ui.TextareaProps{FieldProps: ui.FieldProps{Name: name, Label: T(ctx, "profile.field."+name),
		Hint: T(ctx, "profile.hint."+name), Error: f.Errors[name]}, Value: f.Values[name], MaxLength: maxLen}
}

// check builds a checkbox labelled with profile.field.<name>.
func check(ctx context.Context, f Form, name string) ui.CheckProps {
	return ui.CheckProps{Name: name, Label: T(ctx, "profile.field."+name), Checked: f.Checks[name]}
}

// choice builds a select whose options are labelled with <prefix><value>.
func choice(ctx context.Context, f Form, name, prefix string, values ...string) ui.SelectProps {
	opts := make([]ui.Option, 0, len(values))
	for _, v := range values {
		opts = append(opts, ui.Option{Value: v, Label: T(ctx, prefix+v), Selected: f.Values[name] == v})
	}
	return ui.SelectProps{FieldProps: ui.FieldProps{Name: name, Label: T(ctx, "profile.field."+name), Error: f.Errors[name]},
		Options: opts}
}

// withHint adds a hint to a select.
func withHint(p ui.SelectProps, hint string) ui.SelectProps {
	p.Hint = hint
	return p
}

// station builds a field of a work or education station; id is the station's, or new-exp / new-edu on the add forms.
func station(ctx context.Context, name, id, value string, maxLen int) ui.InputProps {
	p := ui.InputProps{FieldProps: ui.FieldProps{Name: name, Label: T(ctx, "profile.station."+name)}, Value: value,
		MaxLength: maxLen}
	if id != "" {
		p.ID = "f-" + name + "-" + id
	}
	return p
}

// stationBullets is the description field of a work station.
func stationBullets(ctx context.Context, id, value string) ui.TextareaProps {
	p := ui.TextareaProps{FieldProps: ui.FieldProps{Name: "bullets", Label: T(ctx, "profile.station.bullets"),
		Hint: T(ctx, "profile.station.bullets_hint")}, Value: value, MaxLength: 5000}
	if id != "" {
		p.ID = "f-bullets-" + id
	}
	return p
}

// stationCurrent is the "still here" checkbox of a station, labelled with profile.station.<labelKey>.
func stationCurrent(ctx context.Context, id, labelKey string, checked bool) ui.CheckProps {
	p := ui.CheckProps{Name: "is_current", Label: T(ctx, "profile.station."+labelKey), Checked: checked}
	if id != "" {
		p.ID = "f-is_current-" + id
	}
	return p
}

// workplaceSelect is the workplace type of a work station.
func workplaceSelect(ctx context.Context, id, value string) ui.SelectProps {
	opts := []ui.Option{{Value: "", Label: "—", Selected: value == ""}}
	for _, w := range []string{"remote", "hybrid", "onsite"} {
		opts = append(opts, ui.Option{Value: w, Label: T(ctx, "profile.station.workplace."+w), Selected: value == w})
	}
	return ui.SelectProps{FieldProps: ui.FieldProps{ID: "f-workplace-" + id, Name: "workplace_type",
		Label: T(ctx, "profile.station.workplace_type")}, Options: opts}
}

// ntfyToken is the ntfy access token; its owner sees the stored value.
func ntfyToken(ctx context.Context, f Form) ui.InputProps {
	return input(ctx, f, "notify_ntfy_token", "password", "off", 254)
}

// portalName is the brand name of a job portal.
func portalName(p string) string {
	switch p {
	case "linkedin":
		return "LinkedIn"
	case "indeed":
		return "Indeed"
	}
	return p
}

// portalTone shows a connected portal account as success, anything else as neutral.
func portalTone(status string) ui.Tone {
	if status == "active" {
		return ui.Success
	}
	return ui.Neutral
}

templ formNotice(f Form) {
	if f.Notice != "" {
		if f.Failed {
			@ui.Alert(ui.AlertProps{Tone: ui.Danger, Text: f.Notice})
		} else {
			@ui.Alert(ui.AlertProps{Tone: ui.Success, Text: f.Notice})
		}
	}
}

// ProfileExperienceRow is one work experience entry on the profile page.
type ProfileExperienceRow struct {
	ID                 string
	Company            string
	Title              string
	Location           string
	WorkplaceType      string
	StartDate          string
	EndDate            string
	IsCurrent          bool
	DescriptionBullets string
	SortOrder          int
}

// ProfileEducationRow is one education entry on the profile page.
type ProfileEducationRow struct {
	ID           string
	Institution  string
	Degree       string
	FieldOfStudy string
	StartDate    string
	EndDate      string
	IsCurrent    bool
	Grade        string
	SortOrder    int
}

// SaveStateLine is the status of a form that saves itself.
templ SaveStateLine(st SaveState) {
	<p id={ "save-" + st.ID } class="save-state" data-save-state={ st.State } role="status" aria-live="polite">
		if st.State == "saved" {
			@ui.Icon("check")
		} else if st.State != "" {
			@ui.Icon("alert")
		}
		<span>{ st.Text }</span>
	</p>
	if st.Version > 0 {
		<input type="hidden" id={ "version-" + st.ID } name="version" value={ strconv.FormatInt(st.Version, 10) } { HX(ctx, "hx-swap-oob", "true")... }/>
	}
}

// sortHandle starts a drag of its station; the up and down buttons do the same with the keyboard.
templ sortHandle() {
	<span class="st-handle" data-drag-handle aria-hidden="true">
		@ui.Icon("arrow-up-down")
	</span>
}

// stationActions are the save state and the move and delete buttons of one station.
templ stationActions(base, id string) {
	<div class="actions">
		@SaveStateLine(SaveState{ID: id})
		<button { HX(ctx)... } type="submit" class="ui-btn ui-btn-ghost ui-btn-sm" formaction={ templ.SafeURL(base + "/up") }>{ T(ctx, "profile.station.up") }</button>
		<button { HX(ctx)... } type="submit" class="ui-btn ui-btn-ghost ui-btn-sm" formaction={ templ.SafeURL(base + "/down") }>{ T(ctx, "profile.station.down") }</button>
		<button { HX(ctx)... } type="submit" class="ui-btn ui-btn-danger ui-btn-sm" formaction={ templ.SafeURL(base + "/delete") }>{ T(ctx, "profile.station.delete") }</button>
	</div>
}

// saveButton submits a settings form; data-save marks it for the journeys.
templ saveButton() {
	@ui.Button(ui.ButtonProps{Label: T(ctx, "profile.save"), Variant: "primary", Type: "submit", Attrs: templ.Attributes{"data-save": true}})
}

templ ProfilePage(name string, h CandidateHead, f Form, experiences []ProfileExperienceRow, educations []ProfileEducationRow) {
	@candidatePage(T(ctx, "profile.title"), name, h) {
		<p class="muted">{ T(ctx, "profile.text") }</p>
		@formNotice(f)
		if f.Values["focus"] != "" {
			<span hidden data-focus-field={ f.Values["focus"] }></span>
		}
		<form method="post" action="/profile" class="stack" novalidate data-autosave { autosave(ctx, "/profile/autosave", "profile")... }>
			<input type="hidden" id="version-profile" name="version" value={ f.Version }/>
			<h2>{ T(ctx, "profile.section.personal") }</h2>
			@ui.Input(input(ctx, f, "first_name", "text", "given-name", 200))
			@ui.Input(input(ctx, f, "last_name", "text", "family-name", 200))
			@ui.Input(input(ctx, f, "email", "email", "email", 254))
			@ui.Input(input(ctx, f, "phone", "tel", "tel", 30))
			@ui.Input(input(ctx, f, "street", "text", "street-address", 200))
			@ui.Input(input(ctx, f, "postal_code", "text", "postal-code", 12))
			@ui.Input(input(ctx, f, "city", "text", "address-level2", 200))
			@ui.Input(input(ctx, f, "country", "text", "country-name", 200))
			@ui.Input(input(ctx, f, "linkedin", "url", "url", 200))
			@ui.Input(input(ctx, f, "github", "url", "url", 200))
			@ui.Input(input(ctx, f, "website", "url", "url", 200))
			@ui.Input(input(ctx, f, "pronouns", "text", "", 200))
			<h2 class="form-section">{ T(ctx, "profile.section.work") }</h2>
			@ui.Input(input(ctx, f, "current_title", "text", "organization-title", 200))
			@ui.Input(input(ctx, f, "current_employer", "text", "organization", 200))
			@ui.Input(input(ctx, f, "years_total", "text", "", 200))
			@ui.Input(input(ctx, f, "years_relevant", "text", "", 200))
			@ui.Input(input(ctx, f, "notice_period", "text", "", 200))
			@ui.Input(input(ctx, f, "earliest_start", "text", "", 200))
			@ui.Input(input(ctx, f, "salary_expectation", "text", "", 200))
			@ui.Input(input(ctx, f, "workplace_preferred", "text", "", 200))
			@ui.Input(input(ctx, f, "drivers_license", "text", "", 200))
			@ui.Checkbox(check(ctx, f, "work_authorized_eu"))
			@ui.Checkbox(check(ctx, f, "needs_sponsorship"))
			@ui.Checkbox(check(ctx, f, "willing_to_relocate"))
			<h2 class="form-section">{ T(ctx, "profile.section.about") }</h2>
			@ui.Textarea(area(ctx, f, "summary", 5000))
			@ui.Textarea(area(ctx, f, "skills", 12000))
			@ui.Textarea(area(ctx, f, "languages", 3000))
			@ui.Textarea(area(ctx, f, "certifications", 12000))
			@StickyBar() {
				@SaveStateLine(SaveState{ID: "profile", Text: T(ctx, "profile.autosave.hint")})
			}
		</form>
		<h2 class="form-section" id="stations">{ T(ctx, "profile.section.experience") }</h2>
		<form method="post" data-dirty-guard action="/profile/experiences" class="stack" novalidate>
			<h3>{ T(ctx, "profile.station.add_experience") }</h3>
			@ui.Input(station(ctx, "title", "new-exp", "", 200))
			@ui.Input(station(ctx, "company", "new-exp", "", 200))
			@ui.Input(station(ctx, "location", "new-exp", "", 200))
			@ui.Select(workplaceSelect(ctx, "new", ""))
			@ui.Input(station(ctx, "start_date", "new-exp", "", 30))
			@ui.Input(station(ctx, "end_date", "new-exp", "", 30))
			@ui.Checkbox(stationCurrent(ctx, "new-exp", "is_current", false))
			@ui.Textarea(stationBullets(ctx, "new-exp", ""))
			@ui.Button(ui.ButtonProps{Label: T(ctx, "profile.station.add_experience"), Variant: "primary", Type: "submit"})
		</form>
		<div class="st-group" data-sortable>
			<form method="post" action="/profile/experiences/order" data-sort-form hidden { HX(ctx)... }></form>
			<ol class="st-list">
				for _, exp := range experiences {
					<li class="st-item" data-sort-item data-id={ exp.ID }>
						<form method="post" action={ templ.SafeURL("/profile/experiences/" + exp.ID) } class="stack form-section" novalidate data-autosave { autosave(ctx, "/profile/experiences/"+exp.ID+"/autosave", exp.ID)... }>
							@sortHandle()
							@ui.Input(station(ctx, "title", exp.ID, exp.Title, 200))
							@ui.Input(station(ctx, "company", exp.ID, exp.Company, 200))
							@ui.Input(station(ctx, "location", exp.ID, exp.Location, 200))
							@ui.Select(workplaceSelect(ctx, exp.ID, exp.WorkplaceType))
							@ui.Input(station(ctx, "start_date", exp.ID, exp.StartDate, 30))
							@ui.Input(station(ctx, "end_date", exp.ID, exp.EndDate, 30))
							@ui.Checkbox(stationCurrent(ctx, exp.ID, "is_current", exp.IsCurrent))
							@ui.Textarea(stationBullets(ctx, exp.ID, exp.DescriptionBullets))
							@stationActions("/profile/experiences/"+exp.ID, exp.ID)
						</form>
					</li>
				}
			</ol>
		</div>
		<h2 class="form-section">{ T(ctx, "profile.section.education") }</h2>
		<form method="post" data-dirty-guard action="/profile/educations" class="stack" novalidate>
			<h3>{ T(ctx, "profile.station.add_education") }</h3>
			@ui.Input(station(ctx, "degree", "new-edu", "", 200))
			@ui.Input(station(ctx, "institution", "new-edu", "", 200))
			@ui.Input(station(ctx, "field_of_study", "new-edu", "", 200))
			@ui.Input(station(ctx, "start_date", "new-edu", "", 30))
			@ui.Input(station(ctx, "end_date", "new-edu", "", 30))
			@ui.Checkbox(stationCurrent(ctx, "new-edu", "is_current_edu", false))
			@ui.Input(station(ctx, "grade", "new-edu", "", 50))
			@ui.Button(ui.ButtonProps{Label: T(ctx, "profile.station.add_education"), Variant: "primary", Type: "submit"})
		</form>
		<div class="st-group" data-sortable>
			<form method="post" action="/profile/educations/order" data-sort-form hidden { HX(ctx)... }></form>
			<ol class="st-list">
				for _, edu := range educations {
					<li class="st-item" data-sort-item data-id={ edu.ID }>
						<form method="post" action={ templ.SafeURL("/profile/educations/" + edu.ID) } class="stack form-section" novalidate data-autosave { autosave(ctx, "/profile/educations/"+edu.ID+"/autosave", edu.ID)... }>
							@sortHandle()
							@ui.Input(station(ctx, "degree", edu.ID, edu.Degree, 200))
							@ui.Input(station(ctx, "institution", edu.ID, edu.Institution, 200))
							@ui.Input(station(ctx, "field_of_study", edu.ID, edu.FieldOfStudy, 200))
							@ui.Input(station(ctx, "start_date", edu.ID, edu.StartDate, 30))
							@ui.Input(station(ctx, "end_date", edu.ID, edu.EndDate, 30))
							@ui.Checkbox(stationCurrent(ctx, edu.ID, "is_current_edu", edu.IsCurrent))
							@ui.Input(station(ctx, "grade", edu.ID, edu.Grade, 50))
							@stationActions("/profile/educations/"+edu.ID, edu.ID)
						</form>
					</li>
				}
			</ol>
		</div>
	}
}

templ PreferencesPage(name string, f Form, section string) {
	@settingsPage(name, section, false) {
		@formNotice(f)
		switch section {
			case "automation":
				<form method="post" action="/preferences" class="stack set-form" novalidate data-dirty-guard>
					<input type="hidden" name="section" value="automation"/>
					<fieldset class="ui-fieldset">
						<legend class="ui-label">{ T(ctx, "profile.field.autonomy_level") }</legend>
						<div class="ui-options">
							for _, v := range []string{"suggest", "approve", "autonomous"} {
								<div class="ui-check ui-radio">
									<input
										type="radio"
										id={ "f-autonomy-" + v }
										name="autonomy_level"
										value={ v }
										checked?={ f.Values["autonomy_level"] == v }
										aria-describedby={ "f-autonomy-" + v + "-hint" }
									/>
									<label for={ "f-autonomy-" + v }>{ T(ctx, "profile.autonomy." + v) }</label>
									<p class="ui-hint" id={ "f-autonomy-" + v + "-hint" }>{ T(ctx, "settings.autonomy." + v) }</p>
								</div>
							}
						</div>
					</fieldset>
					@ui.Select(withHint(choice(ctx, f, "runner_choice", "profile.runner.", "server", "home_runner", "extension"), T(ctx, "profile.hint.runner_choice")))
					@ui.Input(input(ctx, f, "min_score", "number", "", 3))
					if f.Values["limits_on"] == "true" {
						@ui.Input(input(ctx, f, "daily_limit", "number", "", 3))
					} else {
						<p class="ui-hint">{ T(ctx, "profile.hint.no_limits") }</p>
					}
					<h2>{ T(ctx, "profile.easy_apply.title") }</h2>
					<p class="muted">{ T(ctx, "profile.easy_apply.hint") }</p>
					if f.Values["easy_apply_admin_enabled"] != "true" {
						@ui.Alert(ui.AlertProps{Tone: ui.Warning, Text: T(ctx, "profile.easy_apply.disabled_by_admin")})
					} else {
						@ui.Checkbox(check(ctx, f, "easy_apply_enabled"))
						@ui.Alert(ui.AlertProps{Tone: ui.Warning, Title: T(ctx, "profile.easy_apply.notice_title"), Text: T(ctx, "profile.easy_apply.notice_text")})
						@ui.Checkbox(check(ctx, f, "easy_apply_terms_accepted"))
						if f.Checks["easy_apply_enabled"] {
							<h3>{ T(ctx, "profile.portals.title") }</h3>
							<div class="portal-accounts">
								for _, portal := range []string{"linkedin", "indeed"} {
									<div class="portal-account">
										<strong>{ portalName(portal) }</strong>
										@ui.Badge(T(ctx, "profile.portal.status."+f.Values["portal_status_"+portal]), portalTone(f.Values["portal_status_"+portal]))
										@ui.Input(input(ctx, f, "portal_limit_"+portal, "number", "", 2))
										if f.Values["portal_status_"+portal] == "active" {
											<button type="submit" name="disconnect_portal" value={ portal } class="ui-btn ui-btn-secondary ui-btn-sm">{ T(ctx, "profile.portal.disconnect") }</button>
										}
									</div>
								}
							</div>
						}
					}
					<div class="app-actions">
						@saveButton()
					</div>
				</form>
			case "notifications":
				<form method="post" action="/preferences" class="stack set-form" novalidate data-dirty-guard>
					<input type="hidden" name="section" value="notifications"/>
					<h2>{ T(ctx, "profile.notify.title") }</h2>
					<p class="muted">{ T(ctx, "profile.notify.hint") }</p>
					@ui.Checkbox(check(ctx, f, "notify_email_enabled"))
					@ui.Checkbox(check(ctx, f, "notify_webpush_enabled"))
					@ui.Checkbox(check(ctx, f, "notify_ntfy_enabled"))
					@ui.Input(input(ctx, f, "notify_ntfy_url", "url", "", 254))
					@ui.Input(input(ctx, f, "notify_ntfy_topic", "text", "", 254))
					@ui.Input(ntfyToken(ctx, f))
					@ui.Checkbox(check(ctx, f, "notify_daily_summary_enabled"))
					@ui.Input(input(ctx, f, "notify_daily_summary_time", "text", "", 5))
					@ui.Checkbox(check(ctx, f, "notify_quiet_hours_enabled"))
					@ui.Input(input(ctx, f, "notify_quiet_hours_start", "text", "", 5))
					@ui.Input(input(ctx, f, "notify_quiet_hours_end", "text", "", 5))
					<div class="app-actions">
						@saveButton()
						<button { HX(ctx)... } type="submit" formaction="/preferences/notify/test" class="ui-btn ui-btn-secondary">{ T(ctx, "profile.notify.test") }</button>
					</div>
				</form>
			case "integrations":
				<form { HX(ctx, "hx-replace-url", "/settings/integrations")... } method="post" action="/preferences" class="stack set-form" novalidate data-dirty-guard>
					<input type="hidden" name="section" value="integrations"/>
					<h2>{ T(ctx, "profile.mailbox.title") }</h2>
					<p class="muted">{ T(ctx, "profile.mailbox.hint") }</p>
					@ui.Checkbox(check(ctx, f, "mailbox_enabled"))
					@ui.Input(input(ctx, f, "mailbox_host", "text", "", 254))
					@ui.Input(input(ctx, f, "mailbox_port", "number", "", 5))
					@ui.Input(input(ctx, f, "mailbox_username", "text", "", 254))
					@ui.Input(secret(ctx, f, "mailbox_password", "new-password", true))
					<h2>{ T(ctx, "profile.assist.title") }</h2>
					<p class="muted">{ T(ctx, "profile.assist.hint") }</p>
					<button { HX(ctx)... } type="submit" formaction="/preferences/assist/pair" class="ui-btn ui-btn-secondary">{ T(ctx, "profile.assist.generate_code") }</button>
					<h2>{ T(ctx, "profile.home_runner.title") }</h2>
					<p class="muted">{ T(ctx, "profile.home_runner.hint") }</p>
					<button { HX(ctx)... } type="submit" formaction="/preferences/runner/token" class="ui-btn ui-btn-secondary">{ T(ctx, "profile.home_runner.generate_token") }</button>
					<div class="app-actions">
						@saveButton()
					</div>
				</form>
			default:
				<form method="post" action="/preferences" class="stack set-form" novalidate data-dirty-guard>
					<input type="hidden" name="section" value="search"/>
					@ui.Textarea(area(ctx, f, "titles", 12000))
					@ui.Textarea(area(ctx, f, "exclude_titles", 12000))
					@ui.Textarea(area(ctx, f, "locations", 12000))
					@ui.Checkbox(check(ctx, f, "remote"))
					@ui.Textarea(area(ctx, f, "remote_regions", 3000))
					@ui.Input(input(ctx, f, "min_salary", "number", "", 9))
					@ui.Select(choice(ctx, f, "cover_letter_lang", "profile.lang.", "auto", "en", "de"))
					@ui.Select(choice(ctx, f, "diversity", "profile.diversity.", "decline", "answer"))
					@ui.Checkbox(check(ctx, f, "talent_pool"))
					<div class="app-actions">
						@saveButton()
					</div>
				</form>
		}
	}
}
