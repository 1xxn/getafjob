package views

import "context"

// Form carries the values and errors of a form; Errors hold translated texts by field name.
type Form struct {
	Values  map[string]string
	Checks  map[string]bool
	Errors  map[string]string
	Version string
	Notice  string
	Failed  bool // Notice is an error
}

// input builds the props of a one-line field labelled with profile.field.<name>.
func input(ctx context.Context, f Form, name, typ, autocomplete string, maxLen int) FieldProps {
	return FieldProps{Name: name, Label: T(ctx, "profile.field."+name), Type: typ, Value: f.Values[name],
		Error: f.Errors[name], Autocomplete: autocomplete, MaxLength: maxLen}
}

// area builds the props of a multi-line field with a hint (profile.hint.<name>).
func area(ctx context.Context, f Form, name string, maxLen int) FieldProps {
	return FieldProps{Name: name, Label: T(ctx, "profile.field."+name), Value: f.Values[name], Error: f.Errors[name],
		Hint: T(ctx, "profile.hint."+name), MaxLength: maxLen}
}

templ formNotice(f Form) {
	if f.Notice != "" {
		if f.Failed {
			@Notice("error", f.Notice)
		} else {
			@Notice("info", f.Notice)
		}
	}
}

templ ProfilePage(name string, f Form) {
	@Layout(Page{Title: T(ctx, "profile.title"), UserName: name}) {
		@Section(T(ctx, "profile.title")) {
			<p class="muted">{ T(ctx, "profile.text") }</p>
			@formNotice(f)
			<form method="post" action="/profile" class="stack" novalidate>
				<input type="hidden" name="version" value={ f.Version }/>
				<h2>{ T(ctx, "profile.section.personal") }</h2>
				@Field(input(ctx, f, "first_name", "text", "given-name", 200))
				@Field(input(ctx, f, "last_name", "text", "family-name", 200))
				@Field(input(ctx, f, "email", "email", "email", 254))
				@Field(input(ctx, f, "phone", "tel", "tel", 30))
				@Field(input(ctx, f, "street", "text", "street-address", 200))
				@Field(input(ctx, f, "postal_code", "text", "postal-code", 12))
				@Field(input(ctx, f, "city", "text", "address-level2", 200))
				@Field(input(ctx, f, "country", "text", "country-name", 200))
				@Field(input(ctx, f, "linkedin", "url", "url", 200))
				@Field(input(ctx, f, "github", "url", "url", 200))
				@Field(input(ctx, f, "website", "url", "url", 200))
				@Field(input(ctx, f, "pronouns", "text", "", 200))
				<h2 class="form-section">{ T(ctx, "profile.section.work") }</h2>
				@Field(input(ctx, f, "current_title", "text", "organization-title", 200))
				@Field(input(ctx, f, "current_employer", "text", "organization", 200))
				@Field(input(ctx, f, "years_total", "text", "", 200))
				@Field(input(ctx, f, "years_relevant", "text", "", 200))
				@Field(input(ctx, f, "notice_period", "text", "", 200))
				@Field(input(ctx, f, "earliest_start", "text", "", 200))
				@Field(input(ctx, f, "salary_expectation", "text", "", 200))
				@Field(input(ctx, f, "workplace_preferred", "text", "", 200))
				@Field(input(ctx, f, "drivers_license", "text", "", 200))
				@Check("work_authorized_eu", T(ctx, "profile.field.work_authorized_eu"), f.Checks["work_authorized_eu"])
				@Check("needs_sponsorship", T(ctx, "profile.field.needs_sponsorship"), f.Checks["needs_sponsorship"])
				@Check("willing_to_relocate", T(ctx, "profile.field.willing_to_relocate"), f.Checks["willing_to_relocate"])
				<h2 class="form-section">{ T(ctx, "profile.section.about") }</h2>
				@TextArea(area(ctx, f, "summary", 5000))
				@TextArea(area(ctx, f, "skills", 12000))
				@TextArea(area(ctx, f, "languages", 3000))
				@TextArea(area(ctx, f, "certifications", 12000))
				@StickyBar() {
					<button type="submit" class="primary">{ T(ctx, "profile.save") }</button>
				}
			</form>
		}
	}
}

templ PreferencesPage(name string, f Form) {
	@Layout(Page{Title: T(ctx, "preferences.title"), UserName: name}) {
		@Section(T(ctx, "preferences.title")) {
			<p class="muted">{ T(ctx, "preferences.text") }</p>
			@formNotice(f)
			<form method="post" action="/preferences" class="stack" novalidate>
				@TextArea(area(ctx, f, "titles", 12000))
				@TextArea(area(ctx, f, "exclude_titles", 12000))
				@TextArea(area(ctx, f, "locations", 12000))
				@Check("remote", T(ctx, "profile.field.remote"), f.Checks["remote"])
				@TextArea(area(ctx, f, "remote_regions", 3000))
				@Field(input(ctx, f, "min_salary", "number", "", 9))
				<div class="field">
					<label for="f-cover_letter_lang">{ T(ctx, "profile.field.cover_letter_lang") }</label>
					<select id="f-cover_letter_lang" name="cover_letter_lang">
						for _, v := range []string{"auto", "en", "de"} {
							<option value={ v } selected?={ f.Values["cover_letter_lang"] == v }>{ T(ctx, "profile.lang." + v) }</option>
						}
					</select>
				</div>
				<div class="field">
					<label for="f-diversity">{ T(ctx, "profile.field.diversity") }</label>
					<select id="f-diversity" name="diversity">
						for _, v := range []string{"decline", "answer"} {
							<option value={ v } selected?={ f.Values["diversity"] == v }>{ T(ctx, "profile.diversity." + v) }</option>
						}
					</select>
				</div>
				@Check("talent_pool", T(ctx, "profile.field.talent_pool"), f.Checks["talent_pool"])
				<h2>{ T(ctx, "profile.autonomy.title") }</h2>
				<p class="muted">{ T(ctx, "profile.autonomy.hint") }</p>
				<div class="field">
					<label for="f-autonomy_level">{ T(ctx, "profile.field.autonomy_level") }</label>
					<select id="f-autonomy_level" name="autonomy_level">
						for _, v := range []string{"suggest", "approve", "autonomous"} {
							<option value={ v } selected?={ f.Values["autonomy_level"] == v }>{ T(ctx, "profile.autonomy." + v) }</option>
						}
					</select>
				</div>
				<div class="field">
					<label for="f-runner_choice">{ T(ctx, "profile.field.runner_choice") }</label>
					<select id="f-runner_choice" name="runner_choice">
						for _, v := range []string{"server", "home_runner", "extension"} {
							<option value={ v } selected?={ f.Values["runner_choice"] == v }>{ T(ctx, "profile.runner." + v) }</option>
						}
					</select>
					<p class="hint">{ T(ctx, "profile.hint.runner_choice") }</p>
				</div>
				@Field(input(ctx, f, "min_score", "number", "", 3))
				@Field(input(ctx, f, "daily_limit", "number", "", 3))
				<h2>{ T(ctx, "profile.easy_apply.title") }</h2>
				<p class="muted">{ T(ctx, "profile.easy_apply.hint") }</p>
				if f.Values["easy_apply_admin_enabled"] != "true" {
					<p class="hint warning">{ T(ctx, "profile.easy_apply.disabled_by_admin") }</p>
				} else {
					@Check("easy_apply_enabled", T(ctx, "profile.field.easy_apply_enabled"), f.Checks["easy_apply_enabled"])
					<div class="notice alert warning">
						<strong>{ T(ctx, "profile.easy_apply.notice_title") }</strong>
						<p>{ T(ctx, "profile.easy_apply.notice_text") }</p>
					</div>
					@Check("easy_apply_terms_accepted", T(ctx, "profile.field.easy_apply_terms_accepted"), f.Checks["easy_apply_terms_accepted"])
					if f.Checks["easy_apply_enabled"] {
						<h3>{ T(ctx, "profile.portals.title") }</h3>
						<div class="portal-accounts">
							<div class="portal-account">
								<strong>LinkedIn</strong>:
								<span class={ "badge badge-" + f.Values["portal_status_linkedin"] }>{ T(ctx, "profile.portal.status." + f.Values["portal_status_linkedin"]) }</span>
								@Field(input(ctx, f, "portal_limit_linkedin", "number", "", 2))
								if f.Values["portal_status_linkedin"] == "active" {
									<button type="submit" name="disconnect_portal" value="linkedin" class="btn btn-secondary">{ T(ctx, "profile.portal.disconnect") }</button>
								}
							</div>
							<div class="portal-account">
								<strong>Indeed</strong>:
								<span class={ "badge badge-" + f.Values["portal_status_indeed"] }>{ T(ctx, "profile.portal.status." + f.Values["portal_status_indeed"]) }</span>
								@Field(input(ctx, f, "portal_limit_indeed", "number", "", 2))
								if f.Values["portal_status_indeed"] == "active" {
									<button type="submit" name="disconnect_portal" value="indeed" class="btn btn-secondary">{ T(ctx, "profile.portal.disconnect") }</button>
								}
							</div>
						</div>
					}
				}
				<h2>{ T(ctx, "profile.ai.title") }</h2>
				<p class="muted">{ T(ctx, "profile.ai.hint") }</p>
				if f.Values["ai_admin_enabled"] != "true" {
					<p class="hint warning">{ T(ctx, "profile.ai.disabled_by_admin") }</p>
				} else {
					@Check("ai_enabled", T(ctx, "profile.field.ai_enabled"), f.Checks["ai_enabled"])
					<p class="hint">{ T(ctx, "profile.ai.budget_notice", "spent", f.Values["ai_spent"], "budget", f.Values["ai_budget"]) }</p>
					<div class="field">
						<label for="f-ai_custom_api_key">{ T(ctx, "profile.field.ai_custom_api_key") }</label>
						<input id="f-ai_custom_api_key" name="ai_custom_api_key" type="password" maxlength="254" autocomplete="off" placeholder={ f.Values["ai_key_placeholder"] }/>
						<p class="hint">{ T(ctx, "profile.ai.key_hint") }</p>
					</div>
					if f.Checks["ai_has_custom_key"] {
						@Check("ai_clear_custom_key", T(ctx, "profile.field.ai_clear_custom_key"), false)
					}
				}
				<h2>{ T(ctx, "profile.mailbox.title") }</h2>
				<p class="muted">{ T(ctx, "profile.mailbox.hint") }</p>
				@Check("mailbox_enabled", T(ctx, "profile.field.mailbox_enabled"), f.Checks["mailbox_enabled"])
				@Field(input(ctx, f, "mailbox_host", "text", "", 254))
				@Field(input(ctx, f, "mailbox_port", "number", "", 5))
				@Field(input(ctx, f, "mailbox_username", "text", "", 254))
				<div class="field">
					<label for="f-mailbox_password">{ T(ctx, "profile.field.mailbox_password") }</label>
					<input id="f-mailbox_password" name="mailbox_password" type="password" maxlength="254" autocomplete="new-password"/>
					<p class="hint">{ T(ctx, "profile.hint.mailbox_password") }</p>
				</div>
				<h2>{ T(ctx, "profile.notify.title") }</h2>
				<p class="muted">{ T(ctx, "profile.notify.hint") }</p>
				@Check("notify_email_enabled", T(ctx, "profile.field.notify_email_enabled"), f.Checks["notify_email_enabled"])
				@Field(input(ctx, f, "notify_email_address", "email", "", 254))
				@Check("notify_webpush_enabled", T(ctx, "profile.field.notify_webpush_enabled"), f.Checks["notify_webpush_enabled"])
				@Check("notify_ntfy_enabled", T(ctx, "profile.field.notify_ntfy_enabled"), f.Checks["notify_ntfy_enabled"])
				@Field(input(ctx, f, "notify_ntfy_url", "url", "", 254))
				@Field(input(ctx, f, "notify_ntfy_topic", "text", "", 254))
				<div class="field">
					<label for="f-notify_ntfy_token">{ T(ctx, "profile.field.notify_ntfy_token") }</label>
					<input id="f-notify_ntfy_token" name="notify_ntfy_token" type="password" maxlength="254" value={ f.Values["notify_ntfy_token"] } autocomplete="off"/>
				</div>
				@Check("notify_daily_summary_enabled", T(ctx, "profile.field.notify_daily_summary_enabled"), f.Checks["notify_daily_summary_enabled"])
				@Field(input(ctx, f, "notify_daily_summary_time", "text", "", 5))
				@Check("notify_quiet_hours_enabled", T(ctx, "profile.field.notify_quiet_hours_enabled"), f.Checks["notify_quiet_hours_enabled"])
				@Field(input(ctx, f, "notify_quiet_hours_start", "text", "", 5))
				@Field(input(ctx, f, "notify_quiet_hours_end", "text", "", 5))
				<h2>{ T(ctx, "profile.assist.title") }</h2>
				<p class="muted">{ T(ctx, "profile.assist.hint") }</p>
				<button type="submit" formaction="/preferences/assist/pair" class="secondary">{ T(ctx, "profile.assist.generate_code") }</button>
				<h2>{ T(ctx, "profile.home_runner.title") }</h2>
				<p class="muted">{ T(ctx, "profile.home_runner.hint") }</p>
				<button type="submit" formaction="/preferences/runner/token" class="secondary">{ T(ctx, "profile.home_runner.generate_token") }</button>
				@StickyBar() {
					<button type="submit" class="primary">{ T(ctx, "profile.save") }</button>
					<button type="submit" formaction="/preferences/notify/test" class="secondary">{ T(ctx, "profile.notify.test") }</button>
				}
			</form>
		}
	}
}
