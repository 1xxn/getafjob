package views

import "github.com/1xxn/getafjob/internal/web/views/ui"

// StickyBar holds the primary actions at the bottom of long forms.
templ StickyBar() {
	<div class="stickybar">
		{ children... }
	</div>
}

// PasskeyNudge asks users without a passkey to add one; the single accent of the page.
templ PasskeyNudge() {
	@ui.Alert(ui.AlertProps{Tone: ui.Info}) {
		<p>
			{ T(ctx, "passkey.nudge") }
			<a href="/settings/account">{ T(ctx, "passkey.nudge_link") }</a>
		</p>
	}
}
