package views

import "strings"

// JobRow is one job in the list.
type JobRow struct {
	ID        int64
	Title     string
	Company   string
	Location  string
	Workplace string // remote, hybrid, onsite or empty
	Salary    string // formatted string, e.g. "€75,000 – €90,000" or ""
	Source    string // ATS platform (greenhouse, lever, ashby, workday, personio, etc.)
	Blocked   bool
	Age       int // days since posted or first seen, -1: unknown
	Score     int
	Decision  string
}

// BlocklistItemData is a blocked employer or keyword in the UI.
type BlocklistItemData struct {
	ID        int64
	Kind      string
	Pattern   string
	CreatedAt string
}

// CrawlStatusData fills the crawl sync button and badge.
type CrawlStatusData struct {
	Running bool
	Queued  bool
	LastRun string
}

// JobsData fills the job list.
type JobsData struct {
	Name         string
	Query        string
	Decision     string // relevant, match, maybe, skip, all, blocked
	Workplace    string // "", remote, hybrid, onsite
	Location     string
	Source       string // ATS platform
	MinSalary    int
	Freshness    string // "all", "24h", "3d", "7d", "14d", "30d"
	Sort         string // "match", "newest", "salary", "company"
	Rows         []JobRow
	Total        int
	Page         int
	Pages        int
	Counts       map[string]int
	BlockedCount int
	Pending      bool // no results for the user yet
	PrevURL      string
	NextURL      string
	Blocklist    []BlocklistItemData
	Crawl        CrawlStatusData
}

// Reason is one translated part of a score.
type Reason struct {
	Text   string
	Points int
	Hard   bool
}

// FitBreakdownItem represents one dimension in the score breakdown.
type FitBreakdownItem struct {
	Dimension string
	Label     string
	Points    int
	Max       int
	Detail    string
}

// FitData holds the data for the Fit Inspector widget.
type FitData struct {
	JobID          int64
	Score          int
	Decision       string
	MatchingSkills []string
	MissingSkills  []string
	Breakdown      []FitBreakdownItem
	AddedSkill     string
}

// CVVariantItem is one CV variant selectable for a job.
type CVVariantItem struct {
	ID          string
	Label       string
	Name        string
	Language    string
	Focus       []string
	Selected    bool
	Recommended bool
}

// CVVariantData holds the CV variant switcher data.
type CVVariantData struct {
	JobID      int64
	Variants   []CVVariantItem
	SelectedID string
	Notice     string
}

// JobData fills the job detail page.
type JobData struct {
	Name             string
	Row              JobRow
	Reasons          []Reason
	Description      string
	URL              string // http(s) only, empty otherwise
	ApplyURL         string
	Open             bool
	Computed         string
	Back             string
	Fit              FitData
	CV               CVVariantData
	ApplicationState string
	ApplicationID    string
	Notice           string
	ApplyMode        string // form, portal or email (applymode)
	ApplyHost        string
}

// ExternalApply explains a posting that is applied for outside getafjob and offers the way there (#159).
templ ExternalApply(mode, host, link string, jobID int64) {
	<div class="notice notice-info stack" role="status">
		if mode == "email" {
			<p><strong>{ T(ctx, "apply.email.title") }</strong> { T(ctx, "apply.email.text") }</p>
		} else {
			<p><strong>{ T(ctx, "apply.portal.title", "host", host) }</strong> { T(ctx, "apply.portal.text") }</p>
		}
		<div class="actions">
			if link != "" {
				<a class="button secondary" href={ templ.SafeURL(link) } rel="noopener noreferrer external" target="_blank">{ T(ctx, "apply.open_external") }</a>
			}
			<form method="post" action={ templ.SafeURL("/jobs/" + i64(jobID) + "/apply-external") }>
				<button type="submit">{ T(ctx, "apply.mark_applied") }</button>
			</form>
		</div>
	</div>
}

// PreviewExperience is one experience station in the pre-fill preview.
type PreviewExperience struct {
	Title       string
	Company     string
	Location    string
	Dates       string
	Current     bool
	Description string
}

// PreviewEducation is one education station in the pre-fill preview.
type PreviewEducation struct {
	Institution string
	Degree      string
	Field       string
	Dates       string
	Grade       string
}

// PreviewAnswer is an answer bank entry mapped to form fields.
type PreviewAnswer struct {
	Question string
	Answer   string
}

// PreviewGuardStatus holds safety guard evaluation results.
type PreviewGuardStatus struct {
	Allowed bool
	Reason  string
}

// ApplyPreviewData holds all facts, stations, documents, and guard checks for the pre-fill preview.
type ApplyPreviewData struct {
	Name               string
	JobID              int64
	Title              string
	Company            string
	Location           string
	Workplace          string
	Score              int
	CandidateName      string
	CandidateEmail     string
	CandidatePhone     string
	CandidateLocation  string
	CandidateLinkedIn  string
	CandidateGitHub    string
	CandidatePortfolio string
	CV                 CVVariantData
	SelectedCVName     string
	WorkExperiences    []PreviewExperience
	Educations         []PreviewEducation
	Answers            []PreviewAnswer
	Guard              PreviewGuardStatus
	Notice             string
}

templ jobMeta(r JobRow) {
	<p class="muted job-meta">
		{ r.Company }
		if r.Location != "" {
			· { r.Location }
		}
		if r.Workplace != "" && !strings.Contains(strings.ToLower(r.Location), r.Workplace) {
			· { T(ctx, "jobs.workplace." + r.Workplace) }
		}
		if r.Salary != "" {
			· { r.Salary }
		}
		if r.Source != "" {
			· <span class="badge">{ r.Source }</span>
		}
		if r.Age == 0 {
			· { T(ctx, "jobs.age_today") }
		} else if r.Age > 0 {
			· { T(ctx, "jobs.age_days", "days", r.Age) }
		}
	</p>
}

templ decision(r JobRow) {
	<span class={ "decision", "decision-" + r.Decision }>
		{ T(ctx, "match.decision." + r.Decision) }, { T(ctx, "jobs.score", "score", r.Score) }
	</span>
}

templ option(value, current, label string) {
	<option value={ value } selected?={ value == current }>{ label }</option>
}

templ CrawlStatus(c CrawlStatusData) {
	<div
		id="crawl-status"
		class="crawl-status-bar"
		if c.Running || c.Queued {
			{ HX(ctx, "hx-get", "/jobs/crawl/status", "hx-trigger", "every 3s", "hx-swap", "outerHTML")... }
		}
	>
		<div class="crawl-status-info">
			if c.Running {
				<span class="badge badge-running animate-pulse">{ T(ctx, "jobs.crawl_running") }</span>
			} else if c.Queued {
				<span class="badge badge-queued">{ T(ctx, "jobs.crawl_queued") }</span>
			} else if c.LastRun != "" {
				<span class="badge badge-muted">{ T(ctx, "jobs.crawl_last_run", "time", c.LastRun) }</span>
			} else {
				<span class="badge badge-muted">{ T(ctx, "jobs.crawl_never") }</span>
			}
		</div>
		<form
			method="post"
			action="/jobs/crawl"
			class="crawl-trigger-form"
			{ HX(ctx, "hx-post", "/jobs/crawl", "hx-target", "#crawl-status", "hx-swap", "outerHTML")... }
		>
			<button type="submit" class="btn-sm" disabled?={ c.Running || c.Queued }>
				{ T(ctx, "jobs.crawl_button") }
			</button>
		</form>
	</div>
}

templ BoardAddSuccess(company, atsPlatform string) {
	@Notice("success", T(ctx, "jobs.board_add_success", "company", company, "ats", atsPlatform))
}

templ BoardAddError(msg string) {
	@Notice("error", msg)
}

templ JobsPage(d JobsData) {
	@Layout(Page{Title: T(ctx, "jobs.title"), UserName: d.Name}) {
		@Section(T(ctx, "jobs.title")) {
			<div class="discovery-toolbar">
				<div class="crawl-sync-box">
					@CrawlStatus(d.Crawl)
				</div>
				<form
					method="post"
					action="/jobs/import"
					class="job-import-form"
					{ HX(ctx, "hx-post", "/jobs/import", "hx-target", "#results", "hx-swap", "outerHTML")... }
				>
					<input
						type="url"
						name="url"
						placeholder={ T(ctx, "jobs.import_placeholder") }
						required
						maxlength="500"
					/>
					<button type="submit">{ T(ctx, "jobs.import_button") }</button>
				</form>
				<details class="career-site-panel">
					<summary class="career-site-summary">{ T(ctx, "jobs.board_add_title") }</summary>
					<div class="career-site-body">
						<form
							method="post"
							action="/jobs/boards"
							class="board-add-form"
							{ HX(ctx, "hx-post", "/jobs/boards", "hx-target", "#board-add-result", "hx-swap", "innerHTML")... }
						>
							<input
								type="url"
								name="url"
								placeholder={ T(ctx, "jobs.board_add_placeholder") }
								required
								maxlength="500"
							/>
							<button type="submit">{ T(ctx, "jobs.board_add_button") }</button>
						</form>
						<div id="board-add-result"></div>
					</div>
				</details>
			</div>
			<div id="import-result"></div>
			<form
				method="get"
				action="/jobs"
				class="filters"
				role="search"
				{ HX(ctx, "hx-get", "/jobs", "hx-target", "#results", "hx-swap", "outerHTML", "hx-push-url", "true",
					"hx-trigger", "submit, change, input delay:300ms")... }
			>
				@Field(FieldProps{Name: "q", Label: T(ctx, "jobs.search_label"), Type: "search", Value: d.Query,
					Hint: T(ctx, "jobs.search_hint"), MaxLength: 200})
				@Field(FieldProps{Name: "location", Label: T(ctx, "jobs.location_label"), Type: "text", Value: d.Location,
					MaxLength: 100})
				<div class="field">
					<label for="f-decision">{ T(ctx, "jobs.decision") }</label>
					<select id="f-decision" name="decision">
						@option("relevant", d.Decision, T(ctx, "jobs.decision.relevant"))
						@option("match", d.Decision, T(ctx, "match.decision.match"))
						@option("maybe", d.Decision, T(ctx, "match.decision.maybe"))
						@option("skip", d.Decision, T(ctx, "match.decision.skip"))
						@option("all", d.Decision, T(ctx, "jobs.decision.all"))
						if d.BlockedCount > 0 || d.Decision == "blocked" {
							@option("blocked", d.Decision, T(ctx, "jobs.decision.blocked", "count", d.BlockedCount))
						}
					</select>
				</div>
				<div class="field">
					<label for="f-freshness">{ T(ctx, "jobs.freshness") }</label>
					<select id="f-freshness" name="freshness">
						@option("all", d.Freshness, T(ctx, "jobs.freshness.all"))
						@option("24h", d.Freshness, T(ctx, "jobs.freshness.24h"))
						@option("3d", d.Freshness, T(ctx, "jobs.freshness.3d"))
						@option("7d", d.Freshness, T(ctx, "jobs.freshness.7d"))
						@option("14d", d.Freshness, T(ctx, "jobs.freshness.14d"))
						@option("30d", d.Freshness, T(ctx, "jobs.freshness.30d"))
					</select>
				</div>
				<div class="field">
					<label for="f-sort">{ T(ctx, "jobs.sort") }</label>
					<select id="f-sort" name="sort">
						@option("match", d.Sort, T(ctx, "jobs.sort.match"))
						@option("newest", d.Sort, T(ctx, "jobs.sort.newest"))
						@option("salary", d.Sort, T(ctx, "jobs.sort.salary"))
						@option("company", d.Sort, T(ctx, "jobs.sort.company"))
					</select>
				</div>
				<div class="field">
					<label for="f-workplace">{ T(ctx, "jobs.workplace") }</label>
					<select id="f-workplace" name="workplace">
						@option("", d.Workplace, T(ctx, "jobs.workplace.any"))
						@option("remote", d.Workplace, T(ctx, "jobs.workplace.remote"))
						@option("hybrid", d.Workplace, T(ctx, "jobs.workplace.hybrid"))
						@option("onsite", d.Workplace, T(ctx, "jobs.workplace.onsite"))
					</select>
				</div>
				<div class="field">
					<label for="f-source">{ T(ctx, "jobs.source_label") }</label>
					<select id="f-source" name="source">
						@option("", d.Source, T(ctx, "jobs.source.any"))
						@option("greenhouse", d.Source, "Greenhouse")
						@option("lever", d.Source, "Lever")
						@option("ashby", d.Source, "Ashby")
						@option("workday", d.Source, "Workday")
						@option("personio", d.Source, "Personio")
						@option("smartrecruiters", d.Source, "SmartRecruiters")
						@option("recruitee", d.Source, "Recruitee")
						@option("workable", d.Source, "Workable")
					</select>
				</div>
				<div class="field">
					<label for="f-min-salary">{ T(ctx, "jobs.min_salary_label") }</label>
					<select id="f-min-salary" name="min_salary">
						@option("0", i64(int64(d.MinSalary)), T(ctx, "jobs.min_salary.any"))
						@option("50000", i64(int64(d.MinSalary)), T(ctx, "jobs.min_salary.val", "val", "50.000"))
						@option("60000", i64(int64(d.MinSalary)), T(ctx, "jobs.min_salary.val", "val", "60.000"))
						@option("70000", i64(int64(d.MinSalary)), T(ctx, "jobs.min_salary.val", "val", "70.000"))
						@option("80000", i64(int64(d.MinSalary)), T(ctx, "jobs.min_salary.val", "val", "80.000"))
						@option("90000", i64(int64(d.MinSalary)), T(ctx, "jobs.min_salary.val", "val", "90.000"))
						@option("100000", i64(int64(d.MinSalary)), T(ctx, "jobs.min_salary.val", "val", "100.000"))
					</select>
				</div>
				<button type="submit">{ T(ctx, "jobs.apply_filter") }</button>
			</form>
			@JobResults(d)
		}
	}
}

// JobResults is the part of the list that htmx swaps on search, filters and pages.
templ JobResults(d JobsData) {
	<div id="results">
		if d.Pending {
			@Notice("info", T(ctx, "jobs.pending"))
		} else {
			<details class="blocklist-panel">
				<summary class="blocklist-summary">
					{ T(ctx, "jobs.blocklist_manage") }
					if d.BlockedCount > 0 {
						<span class="badge badge-blocked">{ i64(int64(d.BlockedCount)) }</span>
					}
				</summary>
				<div class="blocklist-body">
					<h4>{ T(ctx, "jobs.blocklist_title") }</h4>
					<form
						method="post"
						action="/jobs/blocklist"
						class="blocklist-add-form"
						{ HX(ctx, "hx-post", "/jobs/blocklist", "hx-target", "#results", "hx-swap", "outerHTML")... }
					>
						<select name="kind">
							<option value="company">{ T(ctx, "jobs.blocklist_kind_company") }</option>
							<option value="keyword">{ T(ctx, "jobs.blocklist_kind_keyword") }</option>
						</select>
						<input type="text" name="pattern" placeholder={ T(ctx, "jobs.blocklist_pattern") } required maxlength="200"/>
						<button type="submit">{ T(ctx, "jobs.blocklist_add") }</button>
					</form>
					if len(d.Blocklist) == 0 {
						<p class="muted">{ T(ctx, "jobs.blocklist_empty") }</p>
					} else {
						<ul class="blocklist-items">
							for _, b := range d.Blocklist {
								<li>
									<span class="badge">{ b.Kind }</span>
									<span class="pattern">{ b.Pattern }</span>
									<form
										method="post"
										action="/jobs/blocklist/delete"
										style="display:inline"
										{ HX(ctx, "hx-post", "/jobs/blocklist/delete", "hx-target", "#results", "hx-swap", "outerHTML")... }
									>
										<input type="hidden" name="id" value={ i64(b.ID) }/>
										<button type="submit" class="btn-link danger">{ T(ctx, "jobs.blocklist_remove") }</button>
									</form>
								</li>
							}
						</ul>
					}
				</div>
			</details>
			<p class="muted" role="status">
				{ T(ctx, "jobs.count", "total", d.Total) }.
				{ T(ctx, "jobs.counts", "match", d.Counts["match"], "maybe", d.Counts["maybe"], "skip", d.Counts["skip"]) }
				if d.BlockedCount > 0 {
					{ " " }
					{ T(ctx, "jobs.counts_blocked", "blocked", d.BlockedCount) }
				}
			</p>
			if len(d.Rows) == 0 {
				<p>{ T(ctx, "jobs.none") }</p>
			}
			<ol class="jobs">
				for _, r := range d.Rows {
					<li>
						<div class="job-header">
							<h2><a href={ templ.SafeURL("/jobs/" + i64(r.ID)) }>{ r.Title }</a></h2>
							<div class="job-actions">
								if r.Blocked {
									<span class="badge badge-blocked">{ T(ctx, "jobs.blocked_badge") }</span>
									<form
										method="post"
										action="/jobs/blocklist/delete"
										style="display:inline"
										{ HX(ctx, "hx-post", "/jobs/blocklist/delete", "hx-target", "#results", "hx-swap", "outerHTML")... }
									>
										<input type="hidden" name="kind" value="company"/>
										<input type="hidden" name="pattern" value={ r.Company }/>
										<button type="submit" class="btn-link">{ T(ctx, "jobs.unblock") }</button>
									</form>
								} else {
									<form
										method="post"
										action="/jobs/blocklist"
										style="display:inline"
										{ HX(ctx, "hx-post", "/jobs/blocklist", "hx-target", "#results", "hx-swap", "outerHTML")... }
									>
										<input type="hidden" name="kind" value="company"/>
										<input type="hidden" name="pattern" value={ r.Company }/>
										<button type="submit" class="btn-link muted" title={ T(ctx, "jobs.block_company") }>{ T(ctx, "jobs.block_company") }</button>
									</form>
								}
							</div>
						</div>
						@jobMeta(r)
						@decision(r)
					</li>
				}
			</ol>
			if d.Pages > 1 {
				<nav class="pager" aria-label={ T(ctx, "jobs.pages") }>
					if d.PrevURL != "" {
						<a href={ templ.SafeURL(d.PrevURL) } rel="prev" { pageLink(ctx, d.PrevURL)... }>{ T(ctx, "jobs.prev") }</a>
					}
					<span>{ T(ctx, "jobs.page", "page", d.Page, "pages", d.Pages) }</span>
					if d.NextURL != "" {
						<a href={ templ.SafeURL(d.NextURL) } rel="next" { pageLink(ctx, d.NextURL)... }>{ T(ctx, "jobs.next") }</a>
					}
				</nav>
			}
		}
	</div>
}

templ FitInspector(d FitData) {
	<div id="fit-inspector" class="fit-inspector">
		<div class="fit-header">
			<h3>{ T(ctx, "jobs.fit.title") }</h3>
			<span class={ "decision", "decision-" + d.Decision }>
				{ T(ctx, "match.decision." + d.Decision) }, { T(ctx, "jobs.score", "score", d.Score) }
			</span>
		</div>
		if d.AddedSkill != "" {
			@Notice("success", T(ctx, "jobs.fit.skill_added", "skill", d.AddedSkill))
		}
		<div class="skills-overlap-section">
			<h4>{ T(ctx, "jobs.fit.matching_skills") }</h4>
			if len(d.MatchingSkills) == 0 {
				<p class="muted">{ T(ctx, "jobs.fit.no_matching_skills") }</p>
			} else {
				<div class="badge-list">
					for _, s := range d.MatchingSkills {
						<span class="badge badge-match">✓ { s }</span>
					}
				</div>
			}
			<h4>{ T(ctx, "jobs.fit.missing_skills") }</h4>
			if len(d.MissingSkills) == 0 {
				<p class="muted">{ T(ctx, "jobs.fit.no_missing_skills") }</p>
			} else {
				<p class="muted text-sm">{ T(ctx, "jobs.fit.missing_skills_hint") }</p>
				<div class="badge-list">
					for _, s := range d.MissingSkills {
						<span class="badge badge-missing">
							<span class="badge-skill-name">{ s }</span>
							<form
								method="post"
								action={ templ.SafeURL("/jobs/" + i64(d.JobID) + "/skills") }
								class="skill-add-inline"
								{ HX(ctx, "hx-post", "/jobs/" + i64(d.JobID) + "/skills", "hx-target", "#fit-inspector", "hx-swap", "outerHTML")... }
							>
								<input type="hidden" name="skill" value={ s }/>
								<button type="submit" class="btn-badge-add" title={ T(ctx, "jobs.fit.add_skill_hint", "skill", s) }>
									+ { T(ctx, "jobs.fit.add") }
								</button>
							</form>
						</span>
					}
				</div>
			}
		</div>
		<div class="fit-breakdown-section">
			<h4>{ T(ctx, "jobs.fit.breakdown_title") }</h4>
			<div class="fit-breakdown-table">
				for _, b := range d.Breakdown {
					<div class="breakdown-row">
						<div class="breakdown-info">
							<span class="breakdown-label">{ b.Label }</span>
							if b.Detail != "" {
								<span class="breakdown-detail muted text-sm">{ b.Detail }</span>
							}
						</div>
						<div class="breakdown-score">
							<span class="breakdown-points">
								if b.Max > 0 {
									{ itoa(b.Points) } / { itoa(b.Max) }
								} else {
									{ points(b.Points) }
								}
							</span>
							if b.Max > 0 {
								<div class="progress-bar" role="progressbar" aria-valuenow={ itoa(b.Points) } aria-valuemin="0" aria-valuemax={ itoa(b.Max) }>
									<div class="progress-fill" style={ "width: " + itoa(min(100, max(0, (b.Points*100)/b.Max))) + "%" }></div>
								</div>
							}
						</div>
					</div>
				}
			</div>
		</div>
	</div>
}

templ CVVariantSwitcher(d CVVariantData) {
	<div id="cv-switcher" class="cv-switcher">
		<h3>{ T(ctx, "jobs.cv_switcher.title") }</h3>
		<p class="muted text-sm">{ T(ctx, "jobs.cv_switcher.hint") }</p>
		if d.Notice != "" {
			@Notice("success", d.Notice)
		}
		if len(d.Variants) == 0 {
			<p class="muted">{ T(ctx, "jobs.cv_switcher.empty") }</p>
		} else {
			<form
				method="post"
				action={ templ.SafeURL("/jobs/" + i64(d.JobID) + "/cv") }
				class="cv-variants-form"
				{ HX(ctx, "hx-post", "/jobs/" + i64(d.JobID) + "/cv", "hx-target", "#cv-switcher", "hx-swap", "outerHTML")... }
			>
				<div class="cv-variant-cards">
					for _, v := range d.Variants {
						<label class={ "cv-variant-card", templ.KV("is-selected", v.Selected) }>
							<input
								type="radio"
								name="cv_id"
								value={ v.ID }
								checked?={ v.Selected }
								onchange="this.form.requestSubmit()"
							/>
							<div class="cv-variant-body">
								<div class="cv-variant-title-row">
									<strong class="cv-variant-title">
										if v.Label != "" {
											{ v.Label }
										} else {
											{ v.Name }
										}
									</strong>
									<div class="cv-variant-badges">
										if v.Selected {
											<span class="badge badge-selected">{ T(ctx, "jobs.cv_switcher.selected") }</span>
										}
										if v.Recommended {
											<span class="badge badge-recommended">{ T(ctx, "jobs.cv_switcher.recommended") }</span>
										}
										if v.Language != "" {
											<span class="badge badge-lang">{ strings.ToUpper(v.Language) }</span>
										}
									</div>
								</div>
								<div class="cv-variant-meta muted text-sm">
									if v.Label != "" && v.Name != "" {
										<span class="cv-variant-filename">{ v.Name }</span>
									}
									if len(v.Focus) > 0 {
										<span class="cv-variant-focus">{ strings.Join(v.Focus, " · ") }</span>
									}
								</div>
							</div>
						</label>
					}
				</div>
				<noscript>
					<button type="submit" class="btn-sm">{ T(ctx, "jobs.cv_switcher.save") }</button>
				</noscript>
			</form>
		}
	</div>
}

templ JobPage(d JobData) {
	@Layout(Page{Title: d.Row.Title, UserName: d.Name}) {
		@Section(d.Row.Title) {
			<p><a href={ templ.SafeURL(d.Back) }>{ T(ctx, "jobs.back") }</a></p>
			@jobMeta(d.Row)
			<div class="job-actions">
				if d.Row.Blocked {
					<span class="badge badge-blocked">{ T(ctx, "jobs.blocked_badge") }</span>
					<form method="post" action="/jobs/blocklist/delete" style="display:inline">
						<input type="hidden" name="kind" value="company"/>
						<input type="hidden" name="pattern" value={ d.Row.Company }/>
						<button type="submit" class="btn-link">{ T(ctx, "jobs.unblock") }</button>
					</form>
				} else {
					<form method="post" action="/jobs/blocklist" style="display:inline">
						<input type="hidden" name="kind" value="company"/>
						<input type="hidden" name="pattern" value={ d.Row.Company }/>
						<button type="submit" class="btn-link muted">{ T(ctx, "jobs.block_company") }</button>
					</form>
				}
			</div>
			if !d.Open {
				@Notice("info", T(ctx, "jobs.closed"))
			}
			if d.Notice != "" {
				@Notice("success", d.Notice)
			}
			if d.ApplyMode == "portal" || d.ApplyMode == "email" {
				@ExternalApply(d.ApplyMode, d.ApplyHost, or(d.ApplyURL, d.URL), d.Row.ID)
			}
			<div class="job-pipeline-actions">
				if d.ApplicationState == "running" || d.ApplicationState == "needs_input" || d.ApplicationState == "queued" {
					<a href={ templ.SafeURL("/applications/" + d.ApplicationID) } class="button primary btn-sm">
						🏃 { T(ctx, "jobs.view_application") }
					</a>
				} else if d.ApplicationState == "submitted" || d.ApplicationState == "confirmed" || d.ApplicationState == "interview" || d.ApplicationState == "offer" {
					<a href={ templ.SafeURL("/applications/" + d.ApplicationID) } class="button secondary btn-sm">
						✓ { T(ctx, "jobs.applied_status") }
					</a>
				} else if d.ApplyMode != "email" {
					<a
						href={ templ.SafeURL("/jobs/" + i64(d.Row.ID) + "/apply") }
						class="button primary btn-sm btn-instant-apply"
						{ HX(ctx, "hx-get", "/jobs/" + i64(d.Row.ID) + "/apply", "hx-target", "#apply-preview-container", "hx-swap", "innerHTML")... }
					>
						⚡ { T(ctx, "jobs.apply_now") }
					</a>
				}
				<form method="post" action={ templ.SafeURL("/jobs/" + i64(d.Row.ID) + "/bookmark") } style="display:inline">
					<button type="submit" class="btn-sm secondary">
						if d.ApplicationState != "" {
							★ { T(ctx, "jobs.saved_to_tracker") }
						} else {
							☆ { T(ctx, "jobs.bookmark") }
						}
					</button>
				</form>
				<form method="post" action={ templ.SafeURL("/jobs/" + i64(d.Row.ID) + "/apply-external") } style="display:inline">
					<button type="submit" class="btn-sm">
						{ T(ctx, "jobs.apply_external") }
					</button>
				</form>
				if d.ApplicationState != "" {
					<a href="/tracker" class="button secondary btn-sm">
						{ T(ctx, "jobs.view_in_tracker") }
					</a>
				}
			</div>
			<div id="apply-preview-container"></div>
			<p>
				if d.URL != "" {
					<a href={ templ.SafeURL(d.URL) } rel="noopener noreferrer external">{ T(ctx, "jobs.open_posting") }</a>
				}
				if d.ApplyURL != "" && d.ApplyURL != d.URL {
					· <a href={ templ.SafeURL(d.ApplyURL) } rel="noopener noreferrer external">{ T(ctx, "jobs.apply_link") }</a>
				}
			</p>
			@FitInspector(d.Fit)
			@CVVariantSwitcher(d.CV)
			<h2>{ T(ctx, "jobs.reasons") }</h2>
			<p>@decision(d.Row)</p>
			<ul class="reasons">
				for _, r := range d.Reasons {
					<li>
						if r.Hard {
							<strong>{ T(ctx, "jobs.reason_filter") }:</strong>
						} else {
							<span class="points">{ points(r.Points) }</span>
						}
						{ r.Text }
					</li>
				}
			</ul>
			<p class="muted">{ T(ctx, "jobs.computed", "when", d.Computed) }</p>
			if d.Description != "" {
				<h2>{ T(ctx, "jobs.description") }</h2>
				<div class="description">{ d.Description }</div>
			}
		}
	}
}

templ ApplyPreview(d ApplyPreviewData) {
	<div id="apply-preview" class="apply-preview-panel">
		<div class="apply-preview-header">
			<div class="apply-preview-titles">
				<h3>⚡ { T(ctx, "jobs.apply_preview.title") }: { d.Title }</h3>
				<p class="muted text-sm">{ d.Company } · { d.Location } · { itoa(d.Score) }% Match</p>
			</div>
			<button
				type="button"
				class="btn-sm btn-link"
				onclick="document.getElementById('apply-preview-container').innerHTML=''"
				title={ T(ctx, "actions.cancel") }
			>
				✕
			</button>
		</div>

		<div class="apply-guarantee-box">
			<strong>🛡️ { T(ctx, "jobs.apply_preview.guarantee_title") }</strong>
			<p class="text-sm">
				{ T(ctx, "jobs.apply_preview.guarantee_desc") }
			</p>
		</div>

		if !d.Guard.Allowed {
			@Notice("error", d.Guard.Reason)
		} else {
			<div class="apply-guard-pass text-sm">
				<span class="badge badge-match">✓ { T(ctx, "jobs.apply_preview.guards_passed") }</span>
			</div>
		}

		<div class="apply-preview-sections">
			<div class="apply-preview-card">
				<h4>1. { T(ctx, "jobs.apply_preview.contact_section") }</h4>
				<div class="preview-fields-grid">
					<div class="preview-field">
						<span class="preview-label">{ T(ctx, "jobs.apply_preview.name") }</span>
						<strong class="preview-val">{ d.CandidateName }</strong>
					</div>
					<div class="preview-field">
						<span class="preview-label">{ T(ctx, "jobs.apply_preview.email") }</span>
						<strong class="preview-val">{ d.CandidateEmail }</strong>
					</div>
					if d.CandidatePhone != "" {
						<div class="preview-field">
							<span class="preview-label">{ T(ctx, "jobs.apply_preview.phone") }</span>
							<span class="preview-val">{ d.CandidatePhone }</span>
						</div>
					}
					if d.CandidateLocation != "" {
						<div class="preview-field">
							<span class="preview-label">{ T(ctx, "jobs.apply_preview.location") }</span>
							<span class="preview-val">{ d.CandidateLocation }</span>
						</div>
					}
					if d.CandidateLinkedIn != "" {
						<div class="preview-field">
							<span class="preview-label">LinkedIn</span>
							<span class="preview-val text-sm">{ d.CandidateLinkedIn }</span>
						</div>
					}
					if d.CandidateGitHub != "" {
						<div class="preview-field">
							<span class="preview-label">GitHub</span>
							<span class="preview-val text-sm">{ d.CandidateGitHub }</span>
						</div>
					}
				</div>
			</div>

			<div class="apply-preview-card">
				<h4>2. { T(ctx, "jobs.apply_preview.cv_section") }</h4>
				if len(d.CV.Variants) == 0 {
					<p class="muted text-sm">{ T(ctx, "jobs.cv_switcher.empty") }</p>
				} else {
					<div class="preview-cv-info">
						<span class="badge badge-selected">📄 { or(d.SelectedCVName, T(ctx, "jobs.apply_preview.default_cv")) }</span>
						<p class="muted text-sm">{ T(ctx, "jobs.apply_preview.cv_hint") }</p>
					</div>
				}
			</div>

			<div class="apply-preview-card">
				<h4>3. { T(ctx, "jobs.apply_preview.stations_section") } ({ itoa(len(d.WorkExperiences)) } Work, { itoa(len(d.Educations)) } Education)</h4>
				if len(d.WorkExperiences) == 0 && len(d.Educations) == 0 {
					<p class="muted text-sm">{ T(ctx, "jobs.apply_preview.no_stations") }</p>
				} else {
					<div class="preview-stations-list">
						for _, exp := range d.WorkExperiences {
							<div class="preview-station-item">
								<strong>{ exp.Title }</strong>{ " @ " }{ exp.Company }
								<span class="muted text-sm"> ({ exp.Dates })</span>
							</div>
						}
						for _, edu := range d.Educations {
							<div class="preview-station-item">
								<strong>{ edu.Degree }{ " in " }{ edu.Field }</strong>{ " @ " }{ edu.Institution }
								<span class="muted text-sm"> ({ edu.Dates })</span>
							</div>
						}
					</div>
				}
			</div>

			if len(d.Answers) > 0 {
				<div class="apply-preview-card">
					<h4>4. { T(ctx, "jobs.apply_preview.answers_section") } ({ itoa(len(d.Answers)) })</h4>
					<div class="preview-answers-list">
						for _, ans := range d.Answers {
							<div class="preview-answer-item">
								<span class="preview-q">Q: { ans.Question }</span>
								<p class="preview-a">A: { ans.Answer }</p>
							</div>
						}
					</div>
				</div>
			}
		</div>

		<div class="apply-preview-footer">
			<form method="post" action={ templ.SafeURL("/jobs/" + i64(d.JobID) + "/apply") }>
				if d.Guard.Allowed {
					<button type="submit" class="button primary">
						🚀 { T(ctx, "jobs.apply_preview.confirm_start") }
					</button>
				} else {
					<button type="submit" class="button primary" disabled>
						⚠️ { T(ctx, "jobs.apply_preview.blocked_by_guard") }
					</button>
				}
				<button
					type="button"
					class="button secondary"
					onclick="document.getElementById('apply-preview-container').innerHTML=''"
				>
					{ T(ctx, "actions.cancel") }
				</button>
			</form>
		</div>
	</div>
}

templ ApplyPreviewPage(d ApplyPreviewData) {
	@Layout(Page{Title: T(ctx, "jobs.apply_preview.title") + " · " + d.Title, UserName: d.Name}) {
		@Section(T(ctx, "jobs.apply_preview.title")) {
			<p><a href={ templ.SafeURL("/jobs/" + i64(d.JobID)) }>← { T(ctx, "jobs.back") }</a></p>
			@ApplyPreview(d)
		}
	}
}
