package views

import "github.com/1xxn/getafjob/internal/web/views/ui"

// JobRow is one job in the list.
type JobRow struct {
	ID        int64
	Title     string
	Company   string
	Location  string
	Workplace string // remote, hybrid, onsite or empty
	Salary    string // formatted string, e.g. "€75,000 – €90,000" or ""
	Source    string // ATS platform (greenhouse, lever, ashby, workday, personio, etc.)
	Blocked   bool
	Age       int // days since posted or first seen, -1: unknown
	Score     int
	Decision  string
	State     string // new, saved, applying, applied, skipped, stopped, closed or empty (jobs.state.*)
	PanelURL  string // list URL with this job open beside it
	PanelGet  string // fragment URL of the job panel
	Current   bool   // open beside the list
}

// BlocklistItemData is a blocked employer or keyword in the UI.
type BlocklistItemData struct {
	ID        int64
	Kind      string
	Pattern   string
	CreatedAt string
}

// CrawlStatusData fills the crawl sync button and badge.
type CrawlStatusData struct {
	Running bool
	Queued  bool
	LastRun string
}

// Reason is one translated part of a score.
type Reason struct {
	Text   string
	Points int
	Hard   bool
}

// FitData is the skill comparison next to a job: found and missing skills, the missing ones one click from the profile.
type FitData struct {
	JobID          int64
	MatchingSkills []string
	MissingSkills  []string
	AddedSkill     string
}

// CVVariantItem is one CV variant selectable for a job.
type CVVariantItem struct {
	ID          string
	Label       string
	Name        string
	Language    string
	Focus       []string
	Selected    bool
	Recommended bool
}

// CVVariantData holds the CV variant switcher data.
type CVVariantData struct {
	JobID      int64
	Variants   []CVVariantItem
	SelectedID string
	Notice     string
}

// JobData fills the job detail page.
type JobData struct {
	Name             string
	Row              JobRow
	Reasons          []Reason
	Description      string
	URL              string // http(s) only, empty otherwise
	ApplyURL         string
	Open             bool
	Computed         string
	Back             string
	Fit              FitData
	CV               CVVariantData
	ApplicationState string
	ApplicationID    string
	Notice           string
	ApplyMode        string // form, portal or email (applymode)
	ApplyHost        string
}

// PreviewExperience is one experience station in the pre-fill preview.
type PreviewExperience struct {
	Title       string
	Company     string
	Location    string
	Dates       string
	Current     bool
	Description string
}

// PreviewEducation is one education station in the pre-fill preview.
type PreviewEducation struct {
	Institution string
	Degree      string
	Field       string
	Dates       string
	Grade       string
}

// PreviewAnswer is an answer bank entry mapped to form fields.
type PreviewAnswer struct {
	Question string
	Answer   string
}

// PreviewGuardStatus holds safety guard evaluation results.
type PreviewGuardStatus struct {
	Allowed bool
	Reason  string
}

// ApplyPreviewData holds all facts, stations, documents, and guard checks for the pre-fill preview.
type ApplyPreviewData struct {
	Name               string
	JobID              int64
	Title              string
	Company            string
	Location           string
	Workplace          string
	Score              int
	CandidateName      string
	CandidateEmail     string
	CandidatePhone     string
	CandidateLocation  string
	CandidateLinkedIn  string
	CandidateGitHub    string
	CandidatePortfolio string
	CV                 CVVariantData
	SelectedCVName     string
	WorkExperiences    []PreviewExperience
	Educations         []PreviewEducation
	Answers            []PreviewAnswer
	Guard              PreviewGuardStatus
	Notice             string
}

templ CrawlStatus(c CrawlStatusData) {
	<div
		id="crawl-status"
		class="crawl-status-bar"
		{ HX(ctx, "hx-get", "/jobs/crawl/status", "hx-trigger", "getafjob:jobs from:body delay:700ms", "hx-swap", "outerMorph transition:false")... }
	>
		<div class="crawl-status-info">
			if c.Running {
				@ui.StatusPill(ui.StatusProps{Label: T(ctx, "jobs.crawl_running"), Tone: ui.Info, Live: true})
			} else if c.Queued {
				@ui.StatusPill(ui.StatusProps{Label: T(ctx, "jobs.crawl_queued"), Tone: ui.Warning})
			} else if c.LastRun != "" {
				@ui.StatusPill(ui.StatusProps{Label: T(ctx, "jobs.crawl_last_run", "time", c.LastRun)})
			} else {
				@ui.StatusPill(ui.StatusProps{Label: T(ctx, "jobs.crawl_never")})
			}
		</div>
		<form
			method="post"
			action="/jobs/crawl"
			class="crawl-trigger-form"
			{ HX(ctx, "hx-post", "/jobs/crawl", "hx-target", "#crawl-status", "hx-swap", "outerHTML")... }
		>
			@ui.Button(ui.ButtonProps{Label: T(ctx, "jobs.crawl_button"), Type: "submit", Size: "sm", Icon: "refresh", Disabled: c.Running || c.Queued})
		</form>
	</div>
}

templ BoardAddSuccess(company, atsPlatform string) {
	@ui.Alert(ui.AlertProps{Tone: ui.Success, Text: T(ctx, "jobs.board_add_success", "company", company, "ats", atsPlatform)})
}

templ BoardAddError(msg string) {
	@ui.Alert(ui.AlertProps{Tone: ui.Danger, Text: msg})
}
