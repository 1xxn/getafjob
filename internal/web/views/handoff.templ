package views

import (
	"context"
	"strconv"
	"time"

	"github.com/1xxn/getafjob/internal/web/views/ui"
)

// HandoffQuestion is one question asked during a run.
type HandoffQuestion struct {
	Kind      string
	Question  string
	Draft     string
	Input     string   // field kind on the employer's form
	Options   []string // choices of radio, select and checkbox groups
	Suggested bool     // the draft comes from a similar question in the answer bank
	Keep      bool     // no run waits: the answer always goes to the bank, so no switch
}

func choiceOptions(q HandoffQuestion) []ui.Option {
	out := make([]ui.Option, 0, len(q.Options))
	for _, o := range q.Options {
		out = append(out, ui.Option{Value: o, Label: o, Selected: q.Draft == o})
	}
	return out
}

func questionHint(ctx context.Context, q HandoffQuestion) string {
	if q.Suggested {
		return T(ctx, "ni.suggested")
	}
	return ""
}

// questionControl renders a control that matches the employer's field (#158); values travel as answer-<i>, and
// save-<i> says whether the answer goes into the answer bank.
templ questionControl(i int, q HandoffQuestion) {
	{{ n := strconv.Itoa(i) }}
	{{ id, name, hint := "q-"+n, "answer-"+n, questionHint(ctx, q) }}
	<div class="ni-question" data-question={ n } data-input={ q.Input }>
		<input type="hidden" name={ "question-" + n } value={ q.Question }/>
		<input type="hidden" name={ "input-" + n } value={ q.Input }/>
		switch {
			case q.Input == "checkbox" || q.Input == "aria_checkbox":
				<input type="hidden" name={ name } value="No"/>
				@ui.Checkbox(ui.CheckProps{ID: id, Name: name, Value: "Yes", Label: questionText(q.Question), Hint: hint, Checked: q.Draft == "Yes"})
			case q.Input == "checkbox_group" && len(q.Options) > 0:
				<fieldset class="ui-fieldset">
					<legend class="ui-label">{ questionText(q.Question) }</legend>
					<div class="ui-options">
						for j, o := range q.Options {
							@ui.Checkbox(ui.CheckProps{ID: id + "-" + strconv.Itoa(j), Name: name, Value: o, Label: o})
						}
					</div>
				</fieldset>
			case len(q.Options) > 0 && len(q.Options) <= 5:
				@ui.RadioGroup(ui.RadioGroupProps{Name: name, Legend: questionText(q.Question), Hint: hint, Options: choiceOptions(q)})
			case len(q.Options) > 0:
				@ui.Select(ui.SelectProps{FieldProps: ui.FieldProps{ID: id, Name: name, Label: questionText(q.Question), Hint: hint},
					Options: append([]ui.Option{{Value: "", Label: T(ctx, "handoff.choose")}}, choiceOptions(q)...)})
			case q.Input == "date":
				@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{ID: id, Name: name, Label: questionText(q.Question), Hint: hint}, Type: "date", Value: q.Draft})
			case q.Input == "number":
				@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{ID: id, Name: name, Label: questionText(q.Question), Hint: hint}, Type: "number", Value: q.Draft})
			case q.Input == "file":
				<div class="ui-field">
					<p class="ui-label">{ questionText(q.Question) }</p>
					<p class="ui-hint">{ T(ctx, "handoff.file_hint") } <a href="/documents">{ T(ctx, "nav.documents") }</a></p>
				</div>
			case q.Input == "textarea" || q.Input == "richtext":
				@ui.Textarea(ui.TextareaProps{FieldProps: ui.FieldProps{ID: id, Name: name, Label: questionText(q.Question), Hint: hint}, Value: q.Draft, Rows: 4})
			default:
				@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{ID: id, Name: name, Label: questionText(q.Question), Hint: hint}, Value: q.Draft})
		}
		if q.Input != "file" && !q.Keep {
			<input type="hidden" name={ "save-" + n } value="0"/>
			@ui.Checkbox(ui.CheckProps{ID: "save-" + n, Name: "save-" + n, Value: "1", Label: T(ctx, "ni.save_bank"), Checked: true, Switch: true})
		}
	</div>
}

// EvidenceFieldRow is one filled form field on the application evidence page.
type EvidenceFieldRow struct {
	Page   int
	Label  string
	Value  string
	Source string
}

// TimelineRow is one chronological event or checkpoint on the application evidence page.
type TimelineRow struct {
	At            time.Time
	Kind          string
	Step          string
	FromState     string
	ToState       string
	Actor         string
	Page          int
	URL           string
	Detail        string
	ScreenshotURL string
}

// SuggestionData holds a status suggestion for the application view.
type SuggestionData struct {
	ID             string
	Category       string
	SuggestedState string
	Reasons        []string
	From           string
	Subject        string
}

// ActiveRunItem holds a summary of an active runner session for switching (#157).
type ActiveRunItem struct {
	AppID    string
	JobID    int64
	JobTitle string
	Company  string
	Current  bool
	Waiting  bool // the run waits for the user
}

// LiveIndicator is the top bar pill with the user's live runs; empty when nothing runs.
templ LiveIndicator(runs []ActiveRunItem) {
	if len(runs) > 0 {
		<a class={ "live-indicator", templ.KV("waiting", anyWaiting(runs)) } href="/live">
			<span class="live-dot pulse"></span>
			{ T(ctx, "live.indicator", "count", len(runs)) }
		</a>
	}
}

// HandoffData fills the application evidence and remote browser page.
type HandoffData struct {
	Name                string
	AppID               string
	JobID               int64
	JobTitle            string
	Company             string
	State               string
	Status              string
	Live                bool   // the run may stream a live view now
	ApplyMode           string // form, portal or email (applymode)
	ApplyHost           string
	ExternalURL         string // where to apply outside getafjob
	ActiveRuns          []ActiveRunItem
	ApprovalAsked       bool
	ApprovalReasons     []string
	Suggestion          *SuggestionData
	Questions           []HandoffQuestion
	Fields              []EvidenceFieldRow
	BeforeSubmitURL     string
	ConfirmationShotURL string
	ConfirmationURL     string
	Confirmed           bool
	Timeline            []TimelineRow
}
