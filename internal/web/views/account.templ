package views

// SessionRow is one signed-in browser on the account page.
type SessionRow struct {
	Method   string // invitation, magic_link, passkey
	Created  string
	LastSeen string
	Current  bool
}

// PasskeyRow is one registered passkey; ID is base64url.
type PasskeyRow struct {
	ID       string
	Name     string
	Created  string
	LastUsed string // empty: never
}

// AccountData is everything the account page shows.
type AccountData struct {
	Name     string
	Notice   string
	Sessions []SessionRow
	Passkeys []PasskeyRow
	Enabled  bool // passkeys configured
	// Recovery describes a pending sign-in without passkey (empty: none).
	Recovery string
}

templ Account(d AccountData) {
	@Layout(Page{Title: T(ctx, "account.title"), UserName: d.Name, Passkeys: d.Enabled}) {
		@Section(T(ctx, "account.title")) {
			if d.Notice != "" {
				@Notice("info", d.Notice)
			}
			if d.Recovery != "" {
				<p class="notice notice-error" role="alert">{ d.Recovery }</p>
				<form method="post" action="/account/recovery/cancel">
					<button type="submit" class="primary">{ T(ctx, "account.recovery.cancel") }</button>
				</form>
			}
			if d.Enabled && len(d.Passkeys) == 0 {
				<p class="notice notice-info">{ T(ctx, "passkey.nudge") }</p>
			}
			if d.Enabled {
				<h2>{ T(ctx, "passkey.title") }</h2>
				<p class="muted">{ T(ctx, "passkey.text") }</p>
				if len(d.Passkeys) > 0 {
					<table class="table">
						<thead>
							<tr>
								<th scope="col">{ T(ctx, "passkey.name") }</th>
								<th scope="col">{ T(ctx, "passkey.created") }</th>
								<th scope="col">{ T(ctx, "passkey.last_used") }</th>
								<th scope="col"><span class="visually-hidden">{ T(ctx, "passkey.actions") }</span></th>
							</tr>
						</thead>
						<tbody>
							for _, p := range d.Passkeys {
								<tr>
									<td>{ p.Name }</td>
									<td>{ p.Created }</td>
									<td>
										if p.LastUsed != "" {
											{ p.LastUsed }
										} else {
											{ T(ctx, "passkey.never") }
										}
									</td>
									<td>
										<form method="post" action={ templ.SafeURL("/account/passkeys/" + p.ID + "/delete") }>
											<button type="submit" class="link">{ T(ctx, "passkey.remove") }</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
				<div class="stack">
					@Field(FieldProps{Name: "passkey-name", Label: T(ctx, "passkey.name"), Type: "text",
						Hint: T(ctx, "passkey.name_hint"), MaxLength: 100})
					<button type="button" class="primary" hidden data-passkey="register" data-name="f-passkey-name"
						data-status="passkey-status" data-error={ T(ctx, "passkey.failed") }>{ T(ctx, "passkey.add") }</button>
					<p id="passkey-status" role="status" class="muted"></p>
					<noscript><p class="muted">{ T(ctx, "passkey.needs_script") }</p></noscript>
				</div>
			}
			<h2>{ T(ctx, "account.sessions.title") }</h2>
			<p class="muted">{ T(ctx, "account.sessions.text") }</p>
			<table class="table">
				<thead>
					<tr>
						<th scope="col">{ T(ctx, "account.sessions.method") }</th>
						<th scope="col">{ T(ctx, "account.sessions.created") }</th>
						<th scope="col">{ T(ctx, "account.sessions.last_seen") }</th>
						<th scope="col"><span class="visually-hidden">{ T(ctx, "account.sessions.state") }</span></th>
					</tr>
				</thead>
				<tbody>
					for _, s := range d.Sessions {
						<tr>
							<td>{ T(ctx, "account.method." + s.Method) }</td>
							<td>{ s.Created }</td>
							<td>{ s.LastSeen }</td>
							<td>
								if s.Current {
									{ T(ctx, "account.sessions.current") }
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(d.Sessions) > 1 {
				<form method="post" action="/account/sessions/others">
					<button type="submit">{ T(ctx, "account.sessions.sign_out_others") }</button>
				</form>
			}
			<h2>{ T(ctx, "account.privacy.title") }</h2>
			<p class="muted">{ T(ctx, "account.privacy.text") }</p>
			<p><a href="/privacy">{ T(ctx, "account.privacy.policy_link") }</a></p>
			<div class="stack">
				<h3>{ T(ctx, "account.privacy.export_title") }</h3>
				<p class="muted">{ T(ctx, "account.privacy.export_text") }</p>
				<form method="get" action="/account/export">
					<button type="submit">{ T(ctx, "account.privacy.export_button") }</button>
				</form>
				<h3>{ T(ctx, "account.privacy.delete_title") }</h3>
				<p class="muted">{ T(ctx, "account.privacy.delete_text") }</p>
				<form method="post" action="/account/delete">
					<button type="submit" class="danger">{ T(ctx, "account.privacy.delete_button") }</button>
				</form>
			</div>
		}
	}
}
