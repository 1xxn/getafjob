package views

import (
	"context"

	"github.com/1xxn/getafjob/internal/web/views/ui"
)

// DocumentRow is one stored file.
type DocumentRow struct {
	ID       string
	Name     string
	Kind     string // cv, certificate, other
	Size     string
	Created  string
	Label    string
	Language string
	Focus    string
	Import   bool // text can be read (PDF or DOCX)
}

func kindOptions(ctx context.Context) []ui.Option {
	var out []ui.Option
	for _, k := range []string{"cv", "certificate", "other"} {
		out = append(out, ui.Option{Value: k, Label: T(ctx, "documents.kind."+k)})
	}
	return out
}

templ DocumentsPage(name string, h CandidateHead, notice string, failed bool, docs []DocumentRow) {
	@candidatePage(T(ctx, "documents.title"), name, h) {
		<p class="app-hint">{ T(ctx, "documents.text") }</p>
		if notice != "" {
			if failed {
				@ui.Alert(ui.AlertProps{Tone: ui.Danger, Text: notice})
			} else {
				@ui.Alert(ui.AlertProps{Tone: ui.Info, Text: notice})
			}
		}
		<form method="post" action="/documents" enctype="multipart/form-data" class="cand-upload" { HX(ctx, "hx-boost", "false")... }>
			@ui.Select(ui.SelectProps{FieldProps: ui.FieldProps{ID: "f-kind", Name: "kind", Label: T(ctx, "documents.kind")}, Options: kindOptions(ctx)})
			<div class="ui-field">
				<label for="f-file" class="ui-label">{ T(ctx, "documents.file") }</label>
				<input id="f-file" name="file" type="file" class="ui-input" required accept=".pdf,.docx,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" aria-describedby="f-file-hint"/>
				<p class="ui-hint" id="f-file-hint">{ T(ctx, "documents.file_hint") }</p>
			</div>
			@ui.Button(ui.ButtonProps{Label: T(ctx, "documents.upload"), Type: "submit", Variant: "primary", Icon: "upload"})
		</form>
		if len(docs) == 0 {
			@ui.EmptyState(ui.EmptyProps{Icon: "file", Title: T(ctx, "documents.empty")})
		} else {
			<div class="cand-list">
				for _, d := range docs {
					<article class="cand-doc" data-doc={ d.ID } data-kind={ d.Kind }>
						<div class="cand-doc-head">
							<div>
								<a href={ templ.URL("/documents/" + d.ID) } class="apps-title" download>{ or(d.Label, d.Name) }</a>
								<span class="ni-item-meta">
									@ui.Badge(T(ctx, "documents.kind."+d.Kind), ui.Neutral)
									if d.Language != "" {
										@ui.Badge(T(ctx, "documents.language."+d.Language), ui.Neutral)
									}
									<span>{ d.Size }</span>
									<span>{ d.Created }</span>
									if d.Label != "" {
										<span>{ d.Name }</span>
									}
								</span>
							</div>
							<form method="post" action={ templ.URL("/documents/" + d.ID + "/delete") } data-confirm={ T(ctx, "documents.delete_confirm", "name", d.Name) }>
								@ui.IconButton(ui.IconButtonProps{Icon: "trash", Label: T(ctx, "documents.delete_named", "name", d.Name), Type: "submit"})
							</form>
						</div>
						if d.Kind == "cv" {
							<details class="cand-variant">
								<summary>{ T(ctx, "documents.variant", "name", or(d.Label, d.Name)) }</summary>
								<form method="post" action={ templ.URL("/documents/" + d.ID + "/variant") } class="app-notes" data-dirty-guard>
									<p class="app-hint">{ T(ctx, "documents.variant_text") }</p>
									@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{ID: "f-label-" + d.ID, Name: "label-" + d.ID, Label: T(ctx, "documents.label")},
										Value: d.Label, MaxLength: 100})
									@ui.Select(ui.SelectProps{FieldProps: ui.FieldProps{ID: "f-language-" + d.ID, Name: "language-" + d.ID, Label: T(ctx, "documents.language")},
										Options: languageOptions(ctx, d.Language)})
									@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{ID: "f-focus-" + d.ID, Name: "focus-" + d.ID, Label: T(ctx, "documents.focus"),
										Hint: T(ctx, "documents.focus_hint")}, Value: d.Focus, MaxLength: 2000})
									<div class="app-actions">
										@ui.Button(ui.ButtonProps{Label: T(ctx, "profile.save"), Type: "submit", Variant: "primary", Icon: "check"})
										if d.Import {
											@ui.Button(ui.ButtonProps{Label: T(ctx, "documents.review"), Href: "/documents/" + d.ID + "/review", Icon: "eye"})
											<button { HX(ctx)... } type="submit" class="ui-btn ui-btn-ghost" formaction={ templ.URL("/documents/" + d.ID + "/import") }>
												@ui.Icon("download")
												<span>{ T(ctx, "documents.import") }</span>
											</button>
										}
									</div>
								</form>
							</details>
						}
					</article>
				}
			</div>
		}
	}
}
