package views

// Layout is the document of every page. Signed-in pages get the app shell with boosted navigation (ADR 0025);
// the islands load once here and bind to their elements after every swap, so no page carries its own script.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html
		lang={ string(Locale(ctx)) }
		if layoutTheme(ctx, p) != "" {
			data-theme={ layoutTheme(ctx, p) }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ p.Title } · getafjob</title>
			<link rel="stylesheet" href={ Asset("ui.css") }/>
			<link rel="stylesheet" href={ Asset("app.css") }/>
			if p.StyleGuide {
				<link rel="stylesheet" href={ Asset("styleguide.css") }/>
			}
			<link rel="icon" href={ Asset("icon.svg") } type="image/svg+xml"/>
			<link rel="manifest" href={ Asset("manifest.webmanifest") }/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<script src={ Asset("vendor/htmx/htmx.min.js") } nonce={ templ.GetNonce(ctx) } defer></script>
			<script src={ Asset("vendor/htmx/hx-csp.min.js") } nonce={ templ.GetNonce(ctx) } defer></script>
			<script src={ Asset("vendor/htmx/hx-sse.min.js") } nonce={ templ.GetNonce(ctx) } defer></script>
			<script type="module" src={ Asset("js/passkey.js") } nonce={ templ.GetNonce(ctx) }></script>
			if p.UserName != "" {
				<script type="module" src={ Asset("js/shell.js") } nonce={ templ.GetNonce(ctx) }></script>
				<script type="module" src={ Asset("js/events.js") } nonce={ templ.GetNonce(ctx) }></script>
				<script type="module" src={ Asset("js/handoff.js") } nonce={ templ.GetNonce(ctx) }></script>
				<script type="module" src={ Asset("js/jobs.js") } nonce={ templ.GetNonce(ctx) }></script>
			}
		</head>
		if p.UserName != "" {
			<body
				class={ "shell", templ.KV("nav-collapsed", ShellFrom(ctx).Collapsed) }
				data-events="1"
				{ HX(ctx, "hx-boost:inherited", "true")... }
			>
				@AppShell(shellFor(ctx, p), p.Handoff || p.StyleGuide || p.Wide) {
					{ children... }
				}
			</body>
		} else {
			<body>
				<a class="skip" href="#main">{ T(ctx, "nav.skip") }</a>
				<header class="topbar">
					<a class="brand" href="/">getafjob</a>
				</header>
				<main id="main" tabindex="-1">
					{ children... }
				</main>
				<footer class="footer">
					<p class="muted"><a href="/privacy">{ T(ctx, "nav.privacy") }</a> · getafjob</p>
				</footer>
			</body>
		}
	</html>
}
