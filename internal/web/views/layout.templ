package views

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang={ string(Locale(ctx)) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<title>{ p.Title } · getafjob</title>
			<link rel="stylesheet" href={ Asset("app.css") }/>
			<link rel="icon" href={ Asset("icon.svg") } type="image/svg+xml"/>
			<link rel="manifest" href={ Asset("manifest.webmanifest") }/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<script src={ Asset("vendor/htmx/htmx.min.js") } nonce={ templ.GetNonce(ctx) } defer></script>
			<script src={ Asset("vendor/htmx/hx-csp.min.js") } nonce={ templ.GetNonce(ctx) } defer></script>
			<script src={ Asset("vendor/htmx/hx-sse.min.js") } nonce={ templ.GetNonce(ctx) } defer></script>
			if p.Passkeys {
				<script type="module" src={ Asset("js/passkey.js") } nonce={ templ.GetNonce(ctx) }></script>
			}
			if p.Handoff {
				<script type="module" src={ Asset("js/handoff.js") } nonce={ templ.GetNonce(ctx) }></script>
			}
		</head>
		<body>
			<a class="skip" href="#main">{ T(ctx, "nav.skip") }</a>
			<header class="topbar">
				<a class="brand" href="/">getafjob</a>
				if p.UserName != "" {
					<nav aria-label={ T(ctx, "nav.main") }>
						<span class="muted">{ T(ctx, "nav.signed_in_as", "name", p.UserName) }</span>
						<span id="live-indicator" { HX(ctx, "hx-get", "/live/indicator", "hx-trigger", "load, every 5s", "hx-swap", "innerHTML")... }></span>
						<a href="/jobs">{ T(ctx, "nav.jobs") }</a>
						<a href="/tracker">{ T(ctx, "nav.tracker") }</a>
						<a href="/approvals">{ T(ctx, "nav.approvals") }</a>
						<a href="/profile">{ T(ctx, "nav.profile") }</a>
						<a href="/preferences">{ T(ctx, "nav.preferences") }</a>
						<a href="/documents">{ T(ctx, "nav.documents") }</a>
						<a href="/answers">{ T(ctx, "nav.answers") }</a>
						<a href="/texts">{ T(ctx, "nav.texts") }</a>
						<a href="/account">{ T(ctx, "nav.account") }</a>
						<form method="post" action="/logout">
							<button type="submit" class="link">{ T(ctx, "nav.sign_out") }</button>
						</form>
					</nav>
				}
			</header>
			<main id="main" tabindex="-1" class={ templ.KV("wide", p.Handoff) }>
				{ children... }
			</main>
			<footer class="footer">
				<p class="muted"><a href="/privacy">{ T(ctx, "nav.privacy") }</a> · getafjob</p>
			</footer>
		</body>
	</html>
}
