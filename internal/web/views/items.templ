package views

import (
	"context"
	"strings"

	"github.com/1xxn/getafjob/internal/web/views/ui"
)

// AnswerRow is one saved answer.
type AnswerRow struct {
	ID, Question, Answer string
	Uses                 int // applications that used it
}

// TextRow is one text block.
type TextRow struct {
	ID, Name, Language, Body string
}

// AnswersData fills the answer bank.
type AnswersData struct {
	Query string
	Rows  []AnswerRow
	Total int // before the search
}

templ AnswersPage(name string, h CandidateHead, f Form, d AnswersData) {
	@candidatePage(T(ctx, "answers.title"), name, h) {
		<p class="app-hint">{ T(ctx, "answers.text") }</p>
		@formNotice(f)
		<div class="cand-tools">
			<form
				method="get"
				action="/answers"
				role="search"
				class="apps-search"
				aria-label={ T(ctx, "answers.search") }
				{ HX(ctx, "hx-get", "/answers", "hx-target", "#answer-list", "hx-select", "#answer-list", "hx-swap", "outerHTML transition:false", "hx-push-url", "true",
					"hx-sync", "this:replace", "hx-trigger", "submit, input changed delay:300ms target:input")... }
			>
				@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{Name: "q", Label: T(ctx, "answers.search"), HideLabel: true},
					Type: "search", Value: d.Query, Placeholder: T(ctx, "answers.search_placeholder"), MaxLength: 200})
			</form>
			@ui.Button(ui.ButtonProps{Label: T(ctx, "answers.add"), Icon: "plus", Attrs: ui.OpenDialog("dlg-answer")})
		</div>
		<div id="answer-list" class="cand-list">
			if d.Total == 0 {
				@ui.EmptyState(ui.EmptyProps{Icon: "message", Title: T(ctx, "answers.empty")})
			} else {
				<p class="app-hint" role="status">{ T(ctx, "answers.count", "shown", len(d.Rows), "total", d.Total) }</p>
			}
			for _, a := range d.Rows {
				<details class="cand-item" data-answer={ a.ID }>
					<summary>
						<span class="cand-item-title">{ a.Question }</span>
						<span class="cand-item-meta">
							if a.Uses > 0 {
								@ui.Badge(T(ctx, "answers.uses", "n", a.Uses), ui.Accent)
							} else {
								@ui.Badge(T(ctx, "answers.unused"), ui.Neutral)
							}
						</span>
						<span class="cand-item-preview">{ a.Answer }</span>
					</summary>
					<form method="post" action={ templ.URL("/answers/" + a.ID) } class="app-notes" data-dirty-guard>
						@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{ID: "f-question-" + a.ID, Name: "question", Label: T(ctx, "answers.question")},
							Value: a.Question, MaxLength: 300})
						@ui.Textarea(ui.TextareaProps{FieldProps: ui.FieldProps{ID: "f-answer-" + a.ID, Name: "answer", Label: T(ctx, "answers.answer")},
							Value: a.Answer, MaxLength: 5000})
						<div class="app-actions">
							@ui.Button(ui.ButtonProps{Label: T(ctx, "profile.save"), Type: "submit", Variant: "primary", Icon: "check"})
							<button
								{ HX(ctx)... }
								type="submit"
								class="ui-btn ui-btn-ghost"
								formaction={ templ.URL("/answers/" + a.ID + "/delete") }
								data-confirm={ T(ctx, "answers.delete_confirm") }
							>
								@ui.Icon("trash")
								<span>{ T(ctx, "passkey.remove") }</span>
							</button>
						</div>
					</form>
				</details>
			}
		</div>
		@ui.Dialog(ui.DialogProps{ID: "dlg-answer", Title: T(ctx, "answers.add"), CloseLabel: T(ctx, "shell.close")}) {
			<form method="post" action="/answers" class="app-notes" data-dirty-guard>
				@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{Name: "question", Label: T(ctx, "answers.question"), Hint: T(ctx, "answers.question_hint"),
					Error: f.Errors["question"]}, Value: f.Values["question"], MaxLength: 300, Attrs: templ.Attributes{"autofocus": true}})
				@ui.Textarea(ui.TextareaProps{FieldProps: ui.FieldProps{Name: "answer", Label: T(ctx, "answers.answer"), Error: f.Errors["answer"]},
					Value: f.Values["answer"], MaxLength: 5000})
				<div class="ui-dialog-actions">
					@ui.Button(ui.ButtonProps{Label: T(ctx, "answers.save"), Type: "submit", Variant: "primary"})
				</div>
			</form>
		}
	}
}

func languageOptions(ctx context.Context, cur string) []ui.Option {
	var out []ui.Option
	for _, l := range []string{"", "en", "de"} {
		out = append(out, ui.Option{Value: l, Label: T(ctx, "documents.language."+or(l, "any")), Selected: cur == l})
	}
	return out
}

templ TextsPage(name string, h CandidateHead, f Form, texts []TextRow, placeholders []string) {
	@candidatePage(T(ctx, "texts.title"), name, h) {
		<p class="app-hint">{ T(ctx, "texts.text") }</p>
		<p class="app-hint">{ T(ctx, "texts.placeholders", "list", "{" + strings.Join(placeholders, "}, {") + "}") }</p>
		@formNotice(f)
		<div class="cand-tools">
			@ui.Button(ui.ButtonProps{Label: T(ctx, "texts.add"), Icon: "plus", Attrs: ui.OpenDialog("dlg-text")})
		</div>
		<div class="cand-list">
			if len(texts) == 0 {
				@ui.EmptyState(ui.EmptyProps{Icon: "type", Title: T(ctx, "texts.empty")})
			}
			for _, t := range texts {
				<details class="cand-item" data-text={ t.ID }>
					<summary>
						<span class="cand-item-title">{ t.Name }</span>
						<span class="cand-item-meta">
							if t.Language != "" {
								@ui.Badge(strings.ToUpper(t.Language), ui.Neutral)
							}
						</span>
						<span class="cand-item-preview">{ t.Body }</span>
					</summary>
					<form method="post" action={ templ.URL("/texts/" + t.ID) } class="app-notes" data-dirty-guard>
						@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{ID: "f-name-" + t.ID, Name: "name", Label: T(ctx, "texts.name")}, Value: t.Name, MaxLength: 100})
						@ui.Select(ui.SelectProps{FieldProps: ui.FieldProps{ID: "f-language-" + t.ID, Name: "language", Label: T(ctx, "documents.language")},
							Options: languageOptions(ctx, t.Language)})
						@ui.Textarea(ui.TextareaProps{FieldProps: ui.FieldProps{ID: "f-body-" + t.ID, Name: "body", Label: T(ctx, "texts.body")}, Value: t.Body,
							Rows: 8, MaxLength: 20000})
						<div class="app-actions">
							@ui.Button(ui.ButtonProps{Label: T(ctx, "profile.save"), Type: "submit", Variant: "primary", Icon: "check"})
							<button
								{ HX(ctx)... }
								type="submit"
								class="ui-btn ui-btn-ghost"
								formaction={ templ.URL("/texts/" + t.ID + "/delete") }
								data-confirm={ T(ctx, "texts.delete_confirm") }
							>
								@ui.Icon("trash")
								<span>{ T(ctx, "passkey.remove") }</span>
							</button>
						</div>
					</form>
				</details>
			}
		</div>
		@ui.Dialog(ui.DialogProps{ID: "dlg-text", Title: T(ctx, "texts.add"), CloseLabel: T(ctx, "shell.close")}) {
			<form method="post" action="/texts" class="app-notes" data-dirty-guard>
				@ui.Input(ui.InputProps{FieldProps: ui.FieldProps{Name: "name", Label: T(ctx, "texts.name"), Error: f.Errors["name"]}, Value: f.Values["name"], MaxLength: 100,
					Attrs: templ.Attributes{"autofocus": true}})
				@ui.Select(ui.SelectProps{FieldProps: ui.FieldProps{ID: "f-language-new", Name: "language", Label: T(ctx, "documents.language")},
					Options: languageOptions(ctx, f.Values["language"])})
				@ui.Textarea(ui.TextareaProps{FieldProps: ui.FieldProps{Name: "body", Label: T(ctx, "texts.body"), Error: f.Errors["body"]}, Value: f.Values["body"],
					Rows: 8, MaxLength: 20000})
				<div class="ui-dialog-actions">
					@ui.Button(ui.ButtonProps{Label: T(ctx, "answers.save"), Type: "submit", Variant: "primary"})
				</div>
			</form>
		}
	}
}
