package views

import (
	"context"
	"time"

	"github.com/1xxn/getafjob/internal/web/views/ui"
)

// DashAction is one entry of the dashboard's action list.
type DashAction struct {
	Kind      string // answer, approve, parked, profile
	Title     string
	Company   string
	Href      string
	ReasonKey string // parked: catalog key of the reason
	VerbKey   string // primary action verb catalog key
	Count     int    // profile: missing fields
	At        time.Time
}

// DashJob is one of the best new matches on the start page.
type DashJob struct {
	ID       int64
	Title    string
	Company  string
	Score    int
	Decision string
}

// DashDay is one bar of the 30 day trend.
type DashDay struct {
	Day   time.Time
	Count int
}

// DashPipeline counts applications by tracker stage.
type DashPipeline struct {
	Applied, Interview, Offer, Closed int
}

// Total reports the number of tracked applications across all pipeline stages.
func (p DashPipeline) Total() int {
	return p.Applied + p.Interview + p.Offer + p.Closed
}

// DashboardData fills the start page.
type DashboardData struct {
	Name            string
	PasskeyNudge    bool
	ProfileMissing  int
	HasApplications bool
	NeedsYou        int
	Answers         int
	Approvals       int
	Parked          int
	Queued          int
	Actions         []DashAction
	Running         []ActiveRunItem
	NewMatches      int
	TopMatches      []DashJob
	Crawl           CrawlStatusData
	Pipeline        DashPipeline
	Trend           []DashDay
	TrendMax        int
	Sent30          int
}

func (d DashboardData) fresh() bool {
	return !d.HasApplications && d.NewMatches == 0 && len(d.Running) == 0 && d.Queued == 0
}

// dayLabel is a short date for the reader's locale: "Nov 12" or "12.11.".
func dayLabel(ctx context.Context, t time.Time) string {
	if Locale(ctx) == "de" {
		return t.In(Zone(ctx)).Format("02.01.")
	}
	return t.In(Zone(ctx)).Format("Jan 2")
}

func actionIcon(kind string) string {
	switch kind {
	case "answer":
		return "message"
	case "approve":
		return "check-circle"
	case "parked":
		return "pause"
	default:
		return "user"
	}
}

func actionTone(kind string) ui.Tone {
	switch kind {
	case "answer", "approve":
		return ui.Warning
	case "parked":
		return ui.Neutral
	default:
		return ui.Info
	}
}

// Dashboard is the start page of signed-in users.
templ Dashboard(d DashboardData) {
	@Layout(Page{Title: T(ctx, "home.title"), UserName: d.Name, Wide: true}) {
		<div class="dash-head">
			<h1>{ T(ctx, "home.greeting", "name", d.Name) }</h1>
			@ui.Button(ui.ButtonProps{Label: T(ctx, "dash.find_jobs"), Href: "/jobs", Variant: "primary", Icon: "search"})
		</div>
		if d.PasskeyNudge {
			<div class="dash-nudge" role="region" aria-label={ T(ctx, "passkey.title") }>
				<p>
					{ T(ctx, "passkey.nudge") }
					<a href="/settings/account">{ T(ctx, "passkey.nudge_link") }</a>
				</p>
				<form method="post" action="/account/passkeys/nudge/dismiss" { HX(ctx, "hx-post", "/account/passkeys/nudge/dismiss", "hx-target", "closest .dash-nudge", "hx-swap", "outerHTML")... }>
					<button type="submit" class="ui-btn ui-btn-ghost ui-btn-sm">{ T(ctx, "dash.nudge.dismiss") }</button>
				</form>
			</div>
		}
		@DashboardBody(d)
	}
}

// DashboardBody is the live part of the dashboard; it morphs on live events, so running pictures keep playing.
templ DashboardBody(d DashboardData) {
	<div id="dashboard" class="dash" { HX(ctx, "hx-get", "/dashboard", "hx-trigger", "getafjob:app from:body delay:700ms, getafjob:jobs from:body delay:700ms", "hx-swap", "outerMorph transition:false")... }>
		if d.fresh() {
			@ui.EmptyState(ui.EmptyProps{Icon: "briefcase", Title: T(ctx, "dash.start.title"), Text: T(ctx, "dash.start.text")}) {
				<ol class="dash-steps">
					<li>{ T(ctx, "dash.start.step1") }</li>
					<li>{ T(ctx, "dash.start.step2") }</li>
					<li>{ T(ctx, "dash.start.step3") }</li>
				</ol>
				if d.ProfileMissing > 0 {
					@ui.Button(ui.ButtonProps{Label: T(ctx, "dash.start.setup"), Href: "/setup", Variant: "primary"})
				} else {
					@ui.Button(ui.ButtonProps{Label: T(ctx, "dash.find_jobs"), Href: "/jobs", Variant: "primary"})
				}
			}
		} else {
			<p id="dash-status" class="dash-status">
				if d.NeedsYou > 0 {
					{ T(ctx, "dash.status.waiting", "n", d.NeedsYou) }
				} else if len(d.Running) > 0 {
					{ T(ctx, "dash.status.running", "n", len(d.Running)) }
				} else {
					{ T(ctx, "dash.status.done") }
				}
			</p>
			if len(d.Actions) > 0 {
				<section class="dash-panel" id="dash-actions" aria-labelledby="dash-actions-title">
					<h2 id="dash-actions-title">{ T(ctx, "dash.todo") }</h2>
					<ul class="dash-list">
						for _, a := range d.Actions {
							<li class="dash-item">
								<span class={ "dash-item-icon", "ui-tone-" + string(actionTone(a.Kind)) }>
									@ui.Icon(actionIcon(a.Kind))
								</span>
								<span class="dash-item-body">
									if a.Kind == "profile" {
										<a href={ templ.SafeURL(a.Href) } class="dash-item-title">{ T(ctx, "dash.action.profile", "n", a.Count) }</a>
										<span class="dash-item-meta">{ T(ctx, "dash.action.profile_hint") }</span>
									} else {
										<a href={ templ.SafeURL(a.Href) } class="dash-item-title">{ a.Title }</a>
										<span class="dash-item-meta">
											{ a.Company } ·
											if a.Kind == "parked" {
												{ T(ctx, a.ReasonKey) }
											} else {
												{ T(ctx, "dash.action." + a.Kind) }
											}
										</span>
									}
								</span>
								<span class="dash-item-actions">
									<a href={ templ.SafeURL(a.Href) } class="ui-btn ui-btn-secondary ui-btn-sm">{ T(ctx, a.VerbKey) }</a>
									if a.Kind == "parked" && a.VerbKey == "dash.act.apply_self" {
										<a href={ templ.SafeURL(a.Href) } class="ui-btn ui-btn-ghost ui-btn-sm">{ T(ctx, "dash.act.discard") }</a>
									}
								</span>
							</li>
						}
					</ul>
					if d.Parked > 5 {
						<p class="dash-more"><a href="/applications?group=attention">{ T(ctx, "dash.parked_more", "n", d.Parked-5) }</a></p>
					}
				</section>
			}
			if len(d.Running) > 0 || d.Queued > 0 {
				<section class="dash-panel" id="dash-running" aria-labelledby="dash-running-title">
					<h2 id="dash-running-title">{ T(ctx, "dash.running") }</h2>
					if len(d.Running) > 0 {
						@dashLiveRun(d.Running[0])
						if len(d.Running) > 1 || d.Queued > 0 {
							<p class="dash-more"><a href="/live">{ T(ctx, "dash.running.all") }</a></p>
						}
					} else {
						<p class="dash-quiet">{ T(ctx, "dash.running.queued", "n", d.Queued) } <a href="/live">{ T(ctx, "dash.running.all") }</a></p>
					}
				</section>
			}
			<section class="dash-panel" id="dash-new" aria-labelledby="dash-new-title">
				<h2 id="dash-new-title">{ T(ctx, "dash.new.best") }</h2>
				if len(d.TopMatches) == 0 {
					<p class="dash-quiet">{ T(ctx, "dash.new.none") }</p>
				} else {
					<ul class="dash-list">
						for _, j := range d.TopMatches {
							<li class="dash-item">
								<span class="dash-item-body">
									<a href={ templ.SafeURL("/jobs/" + i64(j.ID)) } class="dash-item-title">{ j.Title }</a>
									<span class="dash-item-meta">{ j.Company }</span>
								</span>
								@ui.Badge(ScoreLabel(ctx, j.Score)+" · "+itoa(j.Score), scoreTone(j.Decision))
								<a href={ templ.SafeURL("/jobs/" + i64(j.ID)) } class="ui-btn ui-btn-primary ui-btn-sm">{ T(ctx, "dash.new.apply") }</a>
							</li>
						}
					</ul>
					if d.NewMatches > 0 {
						<p class="dash-more"><a href="/jobs">{ T(ctx, "dash.new.all", "n", d.NewMatches) }</a></p>
					}
				}
				<p class="dash-crawl">
					@ui.Icon("refresh")
					if d.Crawl.Running {
						{ T(ctx, "dash.crawl.running") }
					} else if d.Crawl.LastRun != "" {
						{ T(ctx, "dash.crawl.last", "when", d.Crawl.LastRun) }
					} else {
						{ T(ctx, "dash.crawl.never") }
					}
				</p>
			</section>
			if d.Pipeline.Total() > 0 {
				<p id="dash-pipeline" class="dash-pipeline-line">
					{ T(ctx, "dash.pipeline.summary", "applied", d.Pipeline.Applied, "interview", d.Pipeline.Interview, "offer", d.Pipeline.Offer, "closed", d.Pipeline.Closed) }
					<span> · </span>
					<a href="/pipeline">{ T(ctx, "dash.pipeline.open") }</a>
				</p>
			}
		}
	</div>
}

templ dashLiveRun(r ActiveRunItem) {
	<div id={ "dash-run-" + r.AppID } class="dash-live-card">
		@LiveScreen(LiveScreenProps{AppID: r.AppID, Size: "full", FPS: 1})
		<div class="live-card-body">
			<h3 class="live-card-title"><a href={ templ.SafeURL("/live?run=" + r.AppID) }>{ runLabel(r) }</a></h3>
			@runState(r)
			<a href={ templ.SafeURL("/live?run=" + r.AppID) } class="ui-btn ui-btn-secondary ui-btn-sm">{ T(ctx, "dash.running.take_over") }</a>
		</div>
	</div>
}
