package views

import (
	"fmt"
	"strings"

	"github.com/1xxn/getafjob/internal/profile"
)

// DocumentReviewProps holds the properties for rendering the CV import review page.
type DocumentReviewProps struct {
	UserName    string
	DocID       string
	DocName     string
	Notice      string
	Failed      bool
	Profile     profile.Profile
	Experiences []profile.WorkExperience
	Educations  []profile.EducationStation
}

templ DocumentReviewPage(p DocumentReviewProps) {
	@Layout(Page{Title: T(ctx, "documents.review_title"), UserName: p.UserName}) {
		@Section(T(ctx, "documents.review_title")) {
			<p class="muted">{ T(ctx, "documents.review_lead") }</p>
			if p.Notice != "" {
				if p.Failed {
					@Notice("error", p.Notice)
				} else {
					@Notice("info", p.Notice)
				}
			}
			<div class="card rv-intro">
				<strong>{ T(ctx, "documents.file") }:</strong> { p.DocName }
			</div>
			<form method="post" action={ templ.SafeURL("/documents/" + p.DocID + "/review") }>
				<input type="hidden" name="exp_count" value={ fmt.Sprintf("%d", len(p.Experiences)) }/>
				<input type="hidden" name="edu_count" value={ fmt.Sprintf("%d", len(p.Educations)) }/>

				<div class="rv-section">
					<h3>{ T(ctx, "documents.review_exp_title") }</h3>
					if len(p.Experiences) == 0 {
						<p class="muted">{ T(ctx, "documents.review_exp_empty") }</p>
					} else {
						for i, exp := range p.Experiences {
							<div class="card rv-item">
								<div class="rv-row-head">
									<label class="rv-check rv-strong">
										<input type="checkbox" name={ fmt.Sprintf("include_exp_%d", i) } value="1" checked/>
										{ T(ctx, "documents.review_include_position") } #{ fmt.Sprintf("%d", i+1) }
									</label>
								</div>
								<div class="grid rv-grid">
									<div class="field">
										<label>{ T(ctx, "profile.station.company") }</label>
										<input type="text" name={ fmt.Sprintf("exp_%d_company", i) } value={ exp.Company } maxlength="200"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.title") }</label>
										<input type="text" name={ fmt.Sprintf("exp_%d_title", i) } value={ exp.Title } maxlength="200"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.location") }</label>
										<input type="text" name={ fmt.Sprintf("exp_%d_location", i) } value={ exp.Location } maxlength="200"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.workplace_type") }</label>
										<select name={ fmt.Sprintf("exp_%d_workplace", i) }>
											for _, w := range []string{"", "remote", "hybrid", "onsite"} {
												<option value={ w } selected?={ string(exp.WorkplaceType) == w }>
													if w == "" {
														—
													} else {
														{ T(ctx, "profile.station.workplace." + w) }
													}
												</option>
											}
										</select>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.start_date") }</label>
										<input type="text" name={ fmt.Sprintf("exp_%d_start", i) } value={ exp.StartDate } placeholder="YYYY-MM" maxlength="30"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.end_date") }</label>
										<input type="text" name={ fmt.Sprintf("exp_%d_end", i) } value={ exp.EndDate } placeholder="YYYY-MM" maxlength="30"/>
									</div>
								</div>
								<div class="rv-mt-sm">
									<label class="rv-check">
										<input type="checkbox" name={ fmt.Sprintf("exp_%d_current", i) } value="1" checked?={ exp.IsCurrent }/>
										{ T(ctx, "profile.station.is_current") }
									</label>
								</div>
								<div class="field rv-mt">
									<label>{ T(ctx, "profile.station.bullets") }</label>
									<textarea name={ fmt.Sprintf("exp_%d_bullets", i) } rows="3" placeholder={ T(ctx, "documents.review_bullets_hint") }>{ strings.Join(exp.DescriptionBullets, "\n") }</textarea>
								</div>
							</div>
						}
					}
				</div>

				<div class="rv-section">
					<h3>{ T(ctx, "documents.review_edu_title") }</h3>
					if len(p.Educations) == 0 {
						<p class="muted">{ T(ctx, "documents.review_edu_empty") }</p>
					} else {
						for i, edu := range p.Educations {
							<div class="card rv-item">
								<div class="rv-row-head">
									<label class="rv-check rv-strong">
										<input type="checkbox" name={ fmt.Sprintf("include_edu_%d", i) } value="1" checked/>
										{ T(ctx, "documents.review_include_education") } #{ fmt.Sprintf("%d", i+1) }
									</label>
								</div>
								<div class="grid rv-grid">
									<div class="field">
										<label>{ T(ctx, "profile.station.institution") }</label>
										<input type="text" name={ fmt.Sprintf("edu_%d_institution", i) } value={ edu.Institution } maxlength="200"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.degree") }</label>
										<input type="text" name={ fmt.Sprintf("edu_%d_degree", i) } value={ edu.Degree } maxlength="200"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.field_of_study") }</label>
										<input type="text" name={ fmt.Sprintf("edu_%d_field", i) } value={ edu.FieldOfStudy } maxlength="200"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.grade") }</label>
										<input type="text" name={ fmt.Sprintf("edu_%d_grade", i) } value={ edu.Grade } maxlength="50"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.start_date") }</label>
										<input type="text" name={ fmt.Sprintf("edu_%d_start", i) } value={ edu.StartDate } placeholder="YYYY-MM" maxlength="30"/>
									</div>
									<div class="field">
										<label>{ T(ctx, "profile.station.end_date") }</label>
										<input type="text" name={ fmt.Sprintf("edu_%d_end", i) } value={ edu.EndDate } placeholder="YYYY-MM" maxlength="30"/>
									</div>
								</div>
								<div class="rv-mt-sm">
									<label class="rv-check">
										<input type="checkbox" name={ fmt.Sprintf("edu_%d_current", i) } value="1" checked?={ edu.IsCurrent }/>
										{ T(ctx, "profile.station.is_current_edu") }
									</label>
								</div>
							</div>
						}
					}
				</div>

				<div class="card rv-box">
					<label class="rv-check rv-strong">
						<input type="checkbox" name="include_profile" value="1" checked/>
						{ T(ctx, "documents.review_profile_include") }
					</label>
					if len(p.Profile.Skills) > 0 {
						<p class="muted rv-note rv-note-first">
							<strong>{ T(ctx, "profile.field.skills") }:</strong> { strings.Join(p.Profile.Skills, ", ") }
						</p>
					}
					if len(p.Profile.Languages) > 0 {
						<p class="muted rv-note">
							<strong>{ T(ctx, "profile.field.languages") }:</strong>
							for j, lang := range p.Profile.Languages {
								if j > 0 {
									, 
								}
								{ lang.Name } ({ lang.Level })
							}
						</p>
					}
				</div>

				<div class="rv-actions">
					<button type="submit" class="button primary">{ T(ctx, "documents.review_confirm") }</button>
					<a href="/documents" class="button secondary">{ T(ctx, "actions.cancel") }</a>
				</div>
			</form>
		}
	}
}
