# TLS termination in front of serve. GETAFJOB_TLS_MODE: internal (local CA, development) or acme (production).
{
	admin localhost:2019
}

(tls-internal) {
	tls internal
}

(tls-acme) {
	# Certificates via ACME (Let's Encrypt / ZeroSSL); the contact address is required.
	tls {$GETAFJOB_ACME_EMAIL}
}

{$GETAFJOB_DOMAIN:localhost} {
	import tls-{$GETAFJOB_TLS_MODE:internal}

	encode zstd gzip
	header -Server

	# Readiness details stay inside the Compose network.
	@internal path /readyz
	respond @internal 404

	# No access log on purpose: request URIs can carry one-time tokens (magic links, invitations).
	reverse_proxy serve:8080 {
		header_up -X-Forwarded-Host
	}

	# serve does not answer (deploy, restart, crash): the static maintenance page instead of an error (#518). It
	# comes from the app's template (go generate) and needs no script. serve's own maintenance mode passes through.
	handle_errors 502 503 504 {
		root * /srv/maintenance
		rewrite * /index.html
		header {
			-Server
			Retry-After 60
			Cache-Control no-store
			X-Robots-Tag noindex
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
		}
		file_server {
			status 503
		}
	}
}
