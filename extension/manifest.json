{
  "manifest_version": 3,
  "name": "getafjob Assist",
  "version": "1.0.0",
  "description": "Autofill job applications with closed shadow DOM, human approval, and trusted clicks.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "getafjob Assist"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.recaptcha.net/*",
        "*://*.google.com/recaptcha/*",
        "*://*.hcaptcha.com/*",
        "*://challenges.cloudflare.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
